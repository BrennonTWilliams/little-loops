# Loop-run postmortems. Source-repo-only convention (never carried into
# consuming projects). Ignored because run forensics quote traces, paths, and
# issue content from private/sensitive codebases these loops are run against.
postmortems/

# Opt-in private-project name patterns for ll-verify-private-refs. Untracked
# on purpose: a tracked list of private project names would publish exactly
# what the check exists to withhold.
.ll/private-refs.local.txt

# Pre-commit / secret-scan local artifacts
.secrets.baseline

# Archive folders (any depth)
Archive/
_Archive/

# Nested .ll/ directories (e.g. .issues/epics/.ll/) — ignore at any depth,
# but keep the repo-root .ll/ tracked (its noisy files are ignored individually
# above; the decisions log is a curated, committed artifact — both the legacy
# .ll/decisions.yaml flat file and the .ll/decisions.d/*.json append-only
# fragments, which the !/.ll/ un-ignore already tracks).
**/.ll/
!/.ll/
.ll/.fuse_hidden*
# Local mirror of scripts/little_loops/templates/design-tokens/profiles/, written by
# deploy_design_tokens(). Untracked deliberately (ENH-3275): committing it would
# duplicate the packaged profiles byte-for-byte with no drift gate. Recreate with
# `python -c "from pathlib import Path; from little_loops.init.writers import deploy_design_tokens;
# deploy_design_tokens(Path('.ll'), Path('scripts/little_loops/templates'))"`.
.ll/design-tokens/
.codegraph/

# Debug output logs
ll-auto-debug.txt
ll-auto-*-debug.txt

*.mp4
*.gif

assets/marketing/
PRD-Hermes-Integration-*.md
prototypes/
