{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://little-loops.dev/schemas/ll-next-output.json",
  "title": "ll-next --json output",
  "description": "Output envelope of `ll-next --json`. Generated by little_loops.next_arena.render.build_output_schema(); do not edit by hand.",
  "type": "object",
  "required": [
    "schema_version",
    "project_root",
    "as_of",
    "selection_policy",
    "recording",
    "recommendations",
    "explanation",
    "diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 3
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "selection_policy": {
      "$ref": "#/$defs/selection_policy"
    },
    "recording": {
      "$ref": "#/$defs/recording"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "explanation": {
      "anyOf": [
        {
          "$ref": "#/$defs/explanation"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "recording": {
      "description": "Whether the offered rows were stored. `rec_id` values are present only when status is `recorded`. Observational: removing it and the IDs leaves identical recommendations.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "recorded"
            },
            "reason": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "disabled"
            },
            "reason": {
              "enum": [
                "no_record",
                "explain",
                "config_disabled",
                "env_kill_switch",
                "analytics_disabled",
                "command_not_captured",
                "nothing_to_record"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "remote_unsupported_v1",
                "schema_not_ready",
                "write_failed"
              ]
            }
          }
        }
      ]
    },
    "selection_policy": {
      "type": "object",
      "required": [
        "mode",
        "top",
        "bucket_order",
        "caps",
        "dedup",
        "cross_verb_utility_comparison",
        "pressure"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "single_pass",
            "round_robin"
          ]
        },
        "top": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "bucket_order": {
          "type": "array",
          "items": {
            "enum": [
              "implement-issue",
              "refine-issue",
              "resolve-blocker",
              "run-loop"
            ]
          }
        },
        "caps": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "implement-issue",
              "refine-issue",
              "resolve-blocker",
              "run-loop"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "dedup": {
          "type": "string"
        },
        "cross_verb_utility_comparison": {
          "const": false
        },
        "pressure": {
          "type": "null"
        }
      }
    },
    "action_spec": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "variant",
            "command",
            "args",
            "working_directory"
          ],
          "additionalProperties": false,
          "properties": {
            "variant": {
              "const": "slash"
            },
            "command": {
              "type": "string",
              "enum": [
                "confidence-check",
                "format-issue",
                "manage-issue",
                "refine-issue",
                "verify-issues"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "working_directory": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "variant",
            "target",
            "definition_source",
            "definition_digest",
            "fingerprint_scope",
            "working_directory"
          ],
          "additionalProperties": false,
          "properties": {
            "variant": {
              "const": "loop"
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "definition_source": {
              "type": "string",
              "minLength": 1,
              "description": "Project-relative YAML path or `builtin:<relative-YAML-path>` of the resolved top-level source."
            },
            "definition_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "SHA-256 of the captured top-level definition bytes."
            },
            "fingerprint_scope": {
              "const": "v1/top-level-bytes"
            },
            "working_directory": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "axis": {
      "type": "object",
      "required": [
        "raw",
        "curve",
        "score",
        "configured_weight",
        "effective_weight",
        "source",
        "missing_reason"
      ],
      "additionalProperties": false,
      "properties": {
        "raw": {},
        "curve": {
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "configured_weight": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_weight": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "missing"
          ]
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "message",
        "paths",
        "subject"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "alternate": {
      "type": "object",
      "required": [
        "action_type",
        "eligible",
        "action_key",
        "action_fingerprint",
        "display_command",
        "bucket_rank",
        "utility",
        "exclusion_reasons",
        "selection_reason",
        "blocker"
      ],
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "enum": [
            "implement-issue",
            "refine-issue",
            "resolve-blocker",
            "run-loop"
          ]
        },
        "eligible": {
          "type": "boolean"
        },
        "action_key": {
          "anyOf": [
            {
              "enum": [
                "format-issue",
                "verify-issues",
                "confidence-check",
                "refine-issue",
                "manage-issue:fix",
                "manage-issue:implement",
                "manage-issue:improve",
                "run-loop"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "action_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "bucket_rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "utility": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "exclusion_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selection_reason": {
          "type": "string"
        },
        "blocker": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "recommendation": {
      "type": "object",
      "description": "A runnable recommendation: complete, non-null action identity.",
      "required": [
        "rec_id",
        "action_type",
        "action_key",
        "action_fingerprint",
        "action_spec",
        "target",
        "target_key",
        "display_command",
        "axes",
        "gates",
        "utility",
        "selection_score",
        "bucket_rank",
        "pressure",
        "selection_reason",
        "resolved_axes",
        "applicable_axes",
        "coverage",
        "alternates",
        "evidence",
        "diagnostics"
      ],
      "additionalProperties": false,
      "properties": {
        "rec_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "action_type": {
          "type": "string",
          "enum": [
            "implement-issue",
            "refine-issue",
            "resolve-blocker",
            "run-loop"
          ]
        },
        "action_key": {
          "type": "string",
          "enum": [
            "format-issue",
            "verify-issues",
            "confidence-check",
            "refine-issue",
            "manage-issue:fix",
            "manage-issue:implement",
            "manage-issue:improve",
            "run-loop"
          ]
        },
        "action_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "action_spec": {
          "$ref": "#/$defs/action_spec"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "target_key": {
          "type": "string",
          "pattern": "^[a-z]+:.+$"
        },
        "display_command": {
          "type": "string",
          "minLength": 1
        },
        "axes": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "priority",
              "outcome",
              "leverage",
              "effort",
              "momentum",
              "readiness_gap",
              "staleness",
              "frequency",
              "recency",
              "success"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/axis"
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/gate"
          }
        },
        "utility": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "bucket_rank": {
          "type": "integer",
          "minimum": 1
        },
        "pressure": {
          "type": "null"
        },
        "selection_reason": {
          "type": "string"
        },
        "resolved_axes": {
          "type": "integer",
          "minimum": 0
        },
        "applicable_axes": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "alternates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alternate"
          }
        },
        "evidence": {
          "type": "object"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "description": "A target/verb assessment (--explain). Action identity, bucket_rank and utility are null for an excluded or unranked target.",
      "required": [
        "target",
        "target_key",
        "action_type",
        "action_key",
        "action_fingerprint",
        "action_spec",
        "display_command",
        "eligible",
        "exclusion_reasons",
        "axes",
        "gates",
        "utility",
        "selection_score",
        "bucket_rank",
        "pressure",
        "selection_reason",
        "resolved_axes",
        "applicable_axes",
        "coverage",
        "alternates",
        "evidence",
        "diagnostics"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "target_key": {
          "type": "string",
          "pattern": "^[a-z]+:.+$"
        },
        "action_type": {
          "type": "string",
          "enum": [
            "implement-issue",
            "refine-issue",
            "resolve-blocker",
            "run-loop"
          ]
        },
        "action_key": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "format-issue",
                "verify-issues",
                "confidence-check",
                "refine-issue",
                "manage-issue:fix",
                "manage-issue:implement",
                "manage-issue:improve",
                "run-loop"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "action_fingerprint": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "action_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/action_spec"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_command": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "eligible": {
          "type": "boolean"
        },
        "exclusion_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "axes": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "priority",
              "outcome",
              "leverage",
              "effort",
              "momentum",
              "readiness_gap",
              "staleness",
              "frequency",
              "recency",
              "success"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/axis"
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/gate"
          }
        },
        "utility": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "bucket_rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "pressure": {
          "type": "null"
        },
        "selection_reason": {
          "type": "string"
        },
        "resolved_axes": {
          "type": "integer",
          "minimum": 0
        },
        "applicable_axes": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "alternates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alternate"
          }
        },
        "evidence": {
          "type": "object"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "explanation": {
      "type": "object",
      "required": [
        "assessment",
        "alternates"
      ],
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "$ref": "#/$defs/assessment"
        },
        "alternates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assessment"
          }
        }
      }
    }
  }
}
