{
  "color": {
    "surface": {
      "primary":   "{color.neutral.950}",
      "secondary": "{color.neutral.900}",
      "raised":    "{color.neutral.800}"
    },
    "text": {
      "primary":   "{color.neutral.0}",
      "secondary": "{color.neutral.300}",
      "muted":     "{color.neutral.500}",
      "inverse":   "{color.neutral.950}"
    },
    "border": {
      "subtle": "{color.neutral.800}",
      "strong": "{color.neutral.600}"
    },
    "action": {
      "primary":       "{color.brand.500}",
      "primary-hover": "{color.brand.300}",
      "destructive":   "{color.danger.300}",
      "primary-text": "#0b0d0f"
    },
    "status": {
      "success": { "bg": "#14532d", "text": "#bbf7d0" },
      "warning": { "bg": "#713f12", "text": "#fef08a" },
      "error": { "bg": "#7f1d1d", "text": "#fecaca" },
      "info": { "bg": "#164e63", "text": "#a5f3fc" }
    }
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.4)",
    "md": "0 4px 6px rgba(0, 0, 0, 0.5)",
    "lg": "0 10px 15px rgba(0, 0, 0, 0.6)"
  }
}
