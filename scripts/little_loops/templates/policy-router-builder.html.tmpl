<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Policy Router Builder</title>
  <style>
/* Stamped design-token CSS custom properties (light :root + [data-theme=dark]). */
/*__THEMED_CSS_VARS__*/

:root {
  color-scheme: light dark;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: var(--typography-font-family-base, system-ui, sans-serif);
  background: var(--color-surface-base, #ffffff);
  color: var(--color-text-primary, #1a1a1a);
  line-height: 1.5;
}
header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.5rem;
  border-bottom: 1px solid var(--color-border-default, #d0d0d0);
}
h1 { font-size: 1.25rem; margin: 0; }
main {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  padding: 1.5rem;
}
.panel {
  border: 1px solid var(--color-border-default, #d0d0d0);
  border-radius: 8px;
  padding: 1rem;
  background: var(--color-surface-raised, #fafafa);
}
fieldset {
  border: 1px solid var(--color-border-default, #d0d0d0);
  border-radius: 6px;
  margin: 0 0 1rem;
  padding: 0.75rem;
}
legend { font-weight: 600; padding: 0 0.4rem; }
label { display: block; font-size: 0.85rem; margin: 0.4rem 0 0.15rem; }
input, select, textarea, button {
  font: inherit;
  color: inherit;
  background: var(--color-surface-base, #fff);
  border: 1px solid var(--color-border-default, #ccc);
  border-radius: 4px;
  padding: 0.35rem 0.5rem;
}
input[type="text"], input[type="number"], textarea, select { width: 100%; }
textarea { min-height: 4rem; resize: vertical; }
button {
  cursor: pointer;
  background: var(--color-action-primary, #2563eb);
  color: var(--color-action-primary-text, #ffffff);
  border: none;
}
button.secondary {
  background: transparent;
  color: var(--color-text-primary, #1a1a1a);
  border: 1px solid var(--color-border-default, #ccc);
}
.row { display: flex; gap: 0.5rem; align-items: flex-end; flex-wrap: wrap; }
.row > * { flex: 1; }
.row > button { flex: 0 0 auto; }
.outcome-group { border: 1px dashed var(--color-border-default, #ccc); border-radius: 6px; padding: 0.6rem; margin-bottom: 0.75rem; }
.rule-row { display: flex; gap: 0.4rem; align-items: center; margin-bottom: 0.35rem; flex-wrap: wrap; }
.rule-card {
  display: flex;
  gap: 0.4rem;
  align-items: center;
  flex-wrap: wrap;
  border: 1px solid var(--color-border-default, #ccc);
  border-radius: 6px;
  padding: 0.5rem;
  margin-bottom: 0.4rem;
  background: var(--color-surface-base, #fff);
}
.rule-winner {
  outline: 2px solid var(--color-action-primary, #2563eb);
  background: var(--color-status-success-bg, #d4edda);
}
.rule-ord { font-weight: 700; min-width: 1.5rem; }
.rule-move { flex: 0 0 auto; padding: 0.2rem 0.5rem; }
.fallback-row { font-style: italic; opacity: 0.85; }
.fallback-row select { max-width: 16rem; }
pre {
  background: var(--color-surface-sunken, #1e1e1e);
  color: var(--color-text-on-sunken, #e0e0e0);
  padding: 1rem;
  border-radius: 6px;
  overflow: auto;
  max-height: 60vh;
  white-space: pre;
  font-family: var(--typography-font-family-mono, ui-monospace, monospace);
  font-size: 0.8rem;
}
.messages { margin: 0.5rem 0; padding: 0; list-style: none; }
.messages li { padding: 0.3rem 0.5rem; border-radius: 4px; margin-bottom: 0.25rem; font-size: 0.85rem; }
.msg-warn { background: var(--color-status-warning-bg, #fff3cd); color: var(--color-status-warning-text, #856404); }
.msg-error { background: var(--color-status-error-bg, #f8d7da); color: var(--color-status-error-text, #721c24); }
.msg-ok { background: var(--color-status-success-bg, #d4edda); color: var(--color-status-success-text, #155724); }
.hint { font-family: var(--typography-font-family-mono, monospace); font-size: 0.8rem; opacity: 0.8; white-space: pre-line; }
.theme-toggle { font-size: 1.1rem; padding: 0.3rem 0.6rem; }
.del { flex: 0 0 auto; padding: 0.2rem 0.5rem; }
small.help { display: block; opacity: 0.7; font-size: 0.75rem; }
  </style>
</head>
<body>
  <header>
    <h1>Policy Router Builder</h1>
    <div>
      <select id="mode-switch" aria-label="Builder mode">
        <option value="decision_table">Decision Table</option>
        <option value="rubric">Rubric</option>
        <option value="issue_lifecycle">Issue Lifecycle</option>
      </select>
      <button class="secondary" id="undo-btn" type="button" title="Undo (Ctrl/Cmd+Z)">↶ Undo</button>
      <button class="secondary" id="redo-btn" type="button" title="Redo (Ctrl/Cmd+Shift+Z)">↷ Redo</button>
      <button class="secondary theme-toggle" id="theme-toggle" title="Toggle theme">🌙</button>
    </div>
  </header>

  <!-- Stamped project-derived JSON globals (plain script, before the module). -->
  <script>
    window.__GRAMMAR_SPEC__ = /*__GRAMMAR_SPEC_JSON__*/;
    window.__SKILL_CATALOG__ = /*__SKILL_CATALOG_JSON__*/;
    window.__GENERATOR_VERSION__ = /*__GENERATOR_VERSION_JSON__*/;
    window.__ACTIVE_THEME__ = document.documentElement.getAttribute("data-theme") || "light";
  </script>

  <main>
    <section class="panel" id="form-panel">
      <fieldset>
        <legend>Identity</legend>
        <label for="f-name">Loop name</label>
        <input type="text" id="f-name" value="my-policy-loop" />
        <label for="f-subject">What are you grading?</label>
        <input type="text" id="f-subject" value="artifact.md" placeholder="e.g. artifact.md" />
        <label for="f-maxsteps">Max steps</label>
        <input type="number" id="f-maxsteps" value="20" min="1" />
        <label for="f-desc">Description (optional)</label>
        <textarea id="f-desc"></textarea>
      </fieldset>

      <fieldset id="threshold-fieldset" hidden>
        <legend>Thresholds (Rubric)</legend>
        <label for="f-thigh">High threshold: <span id="thigh-val">85</span></label>
        <input type="range" id="f-thigh" min="0" max="100" value="85" />
        <label for="f-tmed">Medium threshold: <span id="tmed-val">65</span></label>
        <input type="range" id="f-tmed" min="0" max="100" value="65" />
      </fieldset>

      <fieldset>
        <legend>Dimensions</legend>
        <div id="dim-list"></div>
        <div class="row">
          <input type="text" id="dim-name" placeholder="dimension name" />
          <select id="dim-type">
            <option value="numeric">numeric</option>
            <option value="boolean">boolean</option>
            <option value="string">string</option>
            <option value="list">list</option>
          </select>
          <button id="add-dim" type="button">Add</button>
        </div>
        <small class="help" id="dim-help">Boolean dimensions are scored 100/0 and compiled to numeric conditions.</small>
      </fieldset>

      <fieldset id="outcomes-fieldset">
        <legend>Outcomes</legend>
        <div id="outcome-list"></div>
        <div class="row" id="outcome-add-row">
          <input type="text" id="outcome-name" placeholder="new outcome name" />
          <button id="add-outcome" type="button">Add outcome</button>
        </div>
        <small class="help" id="outcome-help">Name each destination once; rules below route to these outcomes by name.</small>
      </fieldset>

      <fieldset id="rules-fieldset">
        <legend>Rules (Decision Table)</legend>
        <div id="rule-list"></div>
        <div class="row">
          <button id="add-rule" type="button">+ Rule</button>
        </div>
        <div class="row fallback-row" id="fallback-row">
          <span>Otherwise →</span>
          <select id="f-fallback" aria-label="Fallback outcome" title="Fallback outcome"></select>
        </div>
      </fieldset>

      <fieldset id="tryit-fieldset">
        <legend>Try it</legend>
        <div id="tryit-inputs"></div>
        <small class="help">Enter sample values to see which rule wins — reordering rules above changes the winner live.</small>
      </fieldset>

      <fieldset id="frontmatter-tryit-fieldset" hidden>
        <legend>Try it</legend>
        <textarea id="fm-tryit-input" rows="8" aria-label="Paste issue frontmatter" placeholder="status: open
priority: P2
confidence_score: 40"></textarea>
        <p class="hint" id="fm-tryit-hint"></p>
      </fieldset>
    </section>

    <section class="panel">
      <h2 style="margin-top:0;font-size:1rem;">Result</h2>
      <p id="yaml-summary"></p>
      <ul class="messages" id="messages"></ul>
      <div class="row" style="margin-bottom:0.5rem;">
        <button id="copy-btn" type="button">Copy</button>
        <button id="download-btn" type="button">Download &lt;name&gt;.yaml</button>
        <button id="save-project-btn" type="button" class="secondary">Save project</button>
        <button id="open-project-btn" type="button" class="secondary">Open project</button>
        <input type="file" id="open-project-input" accept="application/json" hidden />
        <button id="start-blank-btn" type="button" class="secondary">Start blank</button>
      </div>
      <p class="hint" id="live-status" role="status" aria-live="polite"></p>
      <p class="hint" id="validate-hint"></p>
      <details id="yaml-details">
        <summary>View generated file</summary>
        <pre id="yaml-preview"></pre>
      </details>
    </section>
  </main>

  <script type="module">
/*__BUILDER_CORE_JS__*/

// ===========================================================================
// UI glue — reads window.__GRAMMAR_SPEC__ / window.__SKILL_CATALOG__ and wires
// a working (visually basic) form to the inlined core. State is a single model
// object matching serializeLoopYaml's contract.
// ===========================================================================
const GRAMMAR = window.__GRAMMAR_SPEC__ || { all_ops: ["==", "!=", ">=", "<=", "<", ">"], ordered_ops: [">=", "<=", "<", ">"] };
const CATALOG = window.__SKILL_CATALOG__ || [];

// `state` is the template's own authoring model — same flat shape as the
// serializer's model contract (see policy_builder_core.mjs header), so
// buildModel() is close to identity and `seedExample()`/`blankModel()` can be
// assigned to it directly (FEAT-2301). Rules are a single ordered array (not
// nested per-outcome) so on-screen order *is* precedence order and moveRule()
// can reorder it directly.
let state = seedExample();

// ===========================================================================
// Draft / project persistence and undo/redo (ENH-3487)
// ===========================================================================
// `drafts` mirrors BuilderProject.drafts: {[mode]: {model}} for every mode
// visited this session. `history` is a whole-project DraftHistory (see
// applyDraftEdit's doc comment in policy_builder_core.mjs) — null until
// hydrateFromStorage() seeds it, so calls to commit() before bootstrap
// finishes (there are none) are a safe no-op.
let drafts = {};
let projectId = _newProjectId();
let history = null;

const _DRAFT_KEY_PREFIX = "ll-policy-builder-draft-";
const _META_KEY = "ll-policy-builder-meta";

function _newProjectId() {
  if (window.crypto && typeof window.crypto.randomUUID === "function") return window.crypto.randomUUID();
  return "proj-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 10);
}

function showLiveStatus(text) {
  const el = document.getElementById("live-status");
  if (el) el.textContent = text;
}

// Tracks whether a storage write has already failed this session so the
// live region warns once (not on every keystroke-commit) — authoring and
// explicit Save-project stay fully functional either way.
let _storageWarned = false;
function _persistDraft(mode, model) {
  try {
    localStorage.setItem(_DRAFT_KEY_PREFIX + mode, JSON.stringify({ model }));
  } catch (e) {
    if (!_storageWarned) {
      _storageWarned = true;
      showLiveStatus("Browser storage is unavailable — drafts won't survive reload this session; use Save project instead.");
    }
  }
}
function _persistAllDrafts(draftsObj) {
  Object.keys(draftsObj).forEach((mode) => _persistDraft(mode, draftsObj[mode].model));
}
function _persistMeta() {
  try {
    localStorage.setItem(
      _META_KEY,
      JSON.stringify({
        projectId,
        activeMode: state.mode,
        schemaVersion: BUILDER_PROJECT_SCHEMA_VERSION,
        generatorVersion: window.__GENERATOR_VERSION__ || "",
      })
    );
  } catch (e) { /* ignore */ }
}
function _readDraft(mode) {
  try {
    const raw = localStorage.getItem(_DRAFT_KEY_PREFIX + mode);
    return raw ? JSON.parse(raw) : null;
  } catch (e) {
    return null;
  }
}
function _readMeta() {
  try {
    const raw = localStorage.getItem(_META_KEY);
    return raw ? JSON.parse(raw) : null;
  } catch (e) {
    return null;
  }
}

function currentProject() {
  return {
    schemaVersion: BUILDER_PROJECT_SCHEMA_VERSION,
    generatorVersion: window.__GENERATOR_VERSION__ || "",
    projectId,
    activeMode: state.mode,
    drafts: { ...drafts, [state.mode]: { model: state } },
  };
}

// Push one committed edit onto the undo/redo stack and persist it. Called
// after every structural button-driven mutation (add/delete/move a
// dimension/outcome/rule, mode switch, Start blank) and, via the delegated
// `change` listener below, after every settled (non-keystroke) field edit.
// A no-op before hydrateFromStorage() has run (history is still null).
function commit() {
  if (!history) return;
  drafts = { ...drafts, [state.mode]: { model: state } };
  history = applyDraftEdit(history, { type: "commit", activeMode: state.mode, drafts });
  _persistDraft(state.mode, state);
  _persistMeta();
  updateUndoRedoButtons();
}

function updateUndoRedoButtons() {
  $("undo-btn").disabled = !history || !history.past.length;
  $("redo-btn").disabled = !history || !history.future.length;
}

function restoreFromSnapshot(snapshot) {
  drafts = snapshot.drafts;
  const mode = snapshot.activeMode;
  state = (drafts[mode] && drafts[mode].model) || seedExample(mode);
  applyStateToForm();
  applyModeVisibility();
  renderAll();
  _persistAllDrafts(drafts);
  _persistMeta();
  updateUndoRedoButtons();
}

// Restore the active mode's draft from localStorage, validating structure
// only (never export-readiness — an unfinished predicate, empty action
// body, missing reference, or invalid budget is editable work, not
// corruption, and must still restore). A structurally invalid stored draft
// falls back to the seed with a live-region diagnostic; the rejected
// payload is left in storage untouched until the next explicit commit()
// overwrites it, so it stays available for manual recovery.
function hydrateFromStorage() {
  const meta = _readMeta();
  const activeMode = (meta && meta.activeMode) || state.mode;
  const draft = _readDraft(activeMode);
  if (draft) {
    const candidate = {
      schemaVersion: BUILDER_PROJECT_SCHEMA_VERSION,
      generatorVersion: (meta && meta.generatorVersion) || "",
      projectId: (meta && meta.projectId) || projectId,
      activeMode,
      drafts: { [activeMode]: draft },
    };
    const errors = validateProjectStructure(candidate);
    if (!errors.length) {
      projectId = candidate.projectId;
      state = draft.model;
      drafts = { [activeMode]: draft };
      applyStateToForm();
    } else {
      showLiveStatus("Saved draft could not be restored (corrupted); starting from the example instead.");
    }
  }
  history = {
    past: [],
    present: { activeMode: state.mode, drafts: { ...drafts, [state.mode]: { model: state } } },
    future: [],
  };
  updateUndoRedoButtons();
}

function buildModel() {
  return {
    mode: state.mode,
    name: state.name,
    description: state.description,
    subject: state.subject,
    maxSteps: state.maxSteps,
    thresholdHigh: state.thresholdHigh,
    thresholdMedium: state.thresholdMedium,
    dimensions: state.dimensions,
    rules: state.rules.map((r) => ({ predicates: r.predicates, target: r.target, isCatchall: false })),
    fallback: state.fallback,
    outcomes: state.outcomes.map((o) => ({
      name: o.name,
      actionType: o.actionType,
      body: o.body,
      args: o.args,
      transition: o.transition,
    })),
  };
}

// One-line plain-language stand-in for the raw YAML (UX model §5 — the YAML
// itself is demoted behind a collapsed <details>; this summary is the
// default view).
function computeSummary(model) {
  const dims = (model.dimensions || []).length;
  const subject = model.subject || "the artifact";
  const steps = model.maxSteps != null ? model.maxSteps : 20;
  if (model.mode === "issue_lifecycle") {
    const verbs = _emittedVerbs(model);
    const routed = verbs.length ? verbs.join(" → ") : "nothing yet";
    return `Routes an issue through its frontmatter on ${dims} field${dims === 1 ? "" : "s"}, runs ≤${steps}×, reaches: ${routed}.`;
  }
  if (model.mode === "rubric") {
    return `Scores ${subject} on ${dims} signal${dims === 1 ? "" : "s"}, runs ≤${steps}×, routes to high/medium/low tiers.`;
  }
  const finishOutcome = (model.outcomes || []).find((o) => o.transition && o.transition.kind === "finish");
  const firstOutcome = model.outcomes && model.outcomes[0];
  const stopsAt = finishOutcome ? finishOutcome.name : model.fallback || (firstOutcome && firstOutcome.name) || "done";
  return `Scores ${subject} on ${dims} signal${dims === 1 ? "" : "s"}, runs ≤${steps}×, stops at ${stopsAt}.`;
}

// opsForType(type) now lives in policy_builder_core.mjs (BUG-3486) — shared
// by the rule editor here and reconcilePredicateForDim.

// ---- renderers -----------------------------------------------------------
const $ = (id) => document.getElementById(id);

// FEAT-3474: built-in issue_lifecycle dimensions render locked (no ✕) in
// #dim-list, ahead of any custom rows. Computed once from the normalized
// built-in name set; state.dimensions is seeded builtins-then-custom and
// built-ins can never be deleted or reordered, so plain array order already
// satisfies "built-ins first, then custom rows in insertion order."
const BUILTIN_DIM_NAMES = new Set(BUILTIN_FRONTMATTER_DIMENSIONS.map((d) => normalizeDimName(d.name)));

function renderDimensions() {
  const host = $("dim-list");
  host.innerHTML = "";
  const isLifecycle = state.mode === "issue_lifecycle";
  state.dimensions.forEach((d, i) => {
    const row = document.createElement("div");
    row.className = "rule-row";
    const norm = normalizeDimName(d.name);
    const isBuiltin = isLifecycle && BUILTIN_DIM_NAMES.has(norm);
    let html = `<strong>${norm}</strong> <em>(${d.type})</em>`;
    if (isBuiltin) {
      html += ` <small class="help">built-in</small>`;
      if (norm === "priority_rank") {
        html += ` <small class="help">(numeric, derived from priority)</small>`;
      }
    }
    row.innerHTML = html;
    if (!isBuiltin) {
      const del = document.createElement("button");
      del.className = "secondary del";
      del.textContent = "✕";
      del.onclick = () => {
        state.dimensions.splice(i, 1);
        renderAll();
        commit();
      };
      row.appendChild(del);
    }
    host.appendChild(row);
  });
}

// The pinned fallback footer: a structured, non-input picker (no free text)
// over the current outcome names. Non-deletable — it always exists and has
// no remove control.
function renderFallback() {
  const sel = $("f-fallback");
  const prev = state.fallback;
  sel.innerHTML = "";
  state.outcomes.forEach((oc) => {
    const o = document.createElement("option");
    o.value = oc.name; o.textContent = oc.name;
    if (oc.name === prev) o.selected = true;
    sel.appendChild(o);
  });
  if (!state.outcomes.some((oc) => oc.name === prev)) {
    state.fallback = state.outcomes.length ? state.outcomes[0].name : "";
  }
  sel.value = state.fallback;
  sel.onchange = () => { state.fallback = sel.value; updatePreview(); };
}

// Per-outcome action authoring only ("Do:" / "And then:"), named once. Rule
// editing (predicates + precedence) lives in renderRules(); outcomes here
// are just the destinations rules point at.
function renderOutcomes() {
  const host = $("outcome-list");
  host.innerHTML = "";
  state.outcomes.forEach((oc, oi) => {
    const grp = document.createElement("div");
    grp.className = "outcome-group";
    const title = document.createElement("div");
    title.className = "row";
    title.innerHTML = `<strong>${oc.name}</strong>`;
    const delOc = document.createElement("button");
    delOc.className = "secondary del";
    delOc.textContent = "✕ outcome";
    const inUse = state.fallback === oc.name || state.rules.some((r) => r.target === oc.name);
    delOc.disabled = inUse;
    delOc.title = inUse
      ? "Can't remove: still used by a rule or the fallback"
      : "Remove this outcome";
    delOc.onclick = () => { state.outcomes.splice(oi, 1); renderAll(); commit(); };
    title.appendChild(delOc);
    grp.appendChild(title);

    // "Do:" / "And then:" authoring — plain language, no internal axis names.
    const author = document.createElement("div");
    author.innerHTML = `<label>Do:</label>`;
    const aSel = document.createElement("select");
    aSel.setAttribute("aria-label", "Action");
    [["prompt", "Prompt"], ["slash_command", "Run a skill"], ["none", "Nothing"]].forEach(([v, t]) => {
      const o = document.createElement("option"); o.value = v; o.textContent = t;
      if (v === oc.actionType) o.selected = true; aSel.appendChild(o);
    });
    const bodyHost = document.createElement("div");
    function renderBody() {
      bodyHost.innerHTML = "";
      if (oc.actionType === "prompt") {
        const ta = document.createElement("textarea");
        ta.value = oc.body || "";
        ta.setAttribute("aria-label", "Prompt text");
        ta.oninput = () => { oc.body = ta.value; updatePreview(); };
        bodyHost.appendChild(ta);
      } else if (oc.actionType === "slash_command") {
        const sel = document.createElement("select");
        sel.setAttribute("aria-label", "Skill");
        const blank = document.createElement("option"); blank.value = ""; blank.textContent = "— choose skill —"; sel.appendChild(blank);
        CATALOG.forEach((s) => {
          const o = document.createElement("option");
          o.value = "/ll:" + s.name; o.textContent = "/ll:" + s.name;
          if (o.value === oc.body) o.selected = true; sel.appendChild(o);
        });
        sel.onchange = () => { oc.body = sel.value; updatePreview(); };
        bodyHost.appendChild(sel);
      }
    }
    aSel.onchange = () => { oc.actionType = aSel.value; renderBody(); updatePreview(); };
    author.appendChild(aSel);
    author.appendChild(bodyHost);

    author.insertAdjacentHTML("beforeend", `<label>And then:</label>`);
    const bSel = document.createElement("select");
    bSel.setAttribute("aria-label", "Follow-up");
    [["rescore", "Score again"], ["goto", "Go to…"], ["finish", "Stop here"]].forEach(([v, t]) => {
      const o = document.createElement("option"); o.value = v; o.textContent = t;
      if (v === (oc.transition && oc.transition.kind)) o.selected = true; bSel.appendChild(o);
    });
    const gotoSel = document.createElement("select");
    gotoSel.setAttribute("aria-label", "Go to outcome");
    function renderGoto() {
      gotoSel.innerHTML = "";
      state.outcomes.forEach((o2) => {
        const o = document.createElement("option"); o.value = o2.name; o.textContent = o2.name;
        if (oc.transition && oc.transition.target === o2.name) o.selected = true; gotoSel.appendChild(o);
      });
      gotoSel.style.display = (oc.transition && oc.transition.kind === "goto") ? "" : "none";
    }
    bSel.onchange = () => {
      oc.transition = { kind: bSel.value, target: gotoSel.value || (state.outcomes[0] && state.outcomes[0].name) };
      renderGoto(); updatePreview();
    };
    gotoSel.onchange = () => { oc.transition.target = gotoSel.value; updatePreview(); };
    author.appendChild(bSel);
    author.appendChild(gotoSel);
    renderBody(); renderGoto();
    grp.appendChild(author);

    host.appendChild(grp);
  });
}

// FEAT-3474: issue_lifecycle's outcome fieldset — five fixed verb rows (no
// add/delete; "verbs cannot be deleted and no new outcomes can be added in
// this mode"). Each row is: verb name, the existing skill-catalog <select>
// (bare `/ll:<name>` values, matching the unknown-skill check), a free-text
// args input, and the existing transition <select>. `implement`'s row shows
// its shell default as read-only <code> until a catalog skill is picked,
// which flips it to a slash_command outcome — matching Verb Table § "Why
// implement is a shell action, not /ll:manage-issue".
function renderLifecycleOutcomes() {
  const host = $("outcome-list");
  host.innerHTML = "";
  state.outcomes.forEach((oc) => {
    const grp = document.createElement("div");
    grp.className = "outcome-group";

    const title = document.createElement("div");
    title.className = "row";
    title.innerHTML = `<strong>${oc.name}</strong>`;
    grp.appendChild(title);

    const skillRow = document.createElement("div");
    skillRow.innerHTML = `<label>Skill:</label>`;
    if (oc.name === "implement" && oc.actionType === "shell") {
      const code = document.createElement("code");
      code.textContent = "ll-auto --only $ISSUE";
      skillRow.appendChild(code);
      const help = document.createElement("small");
      help.className = "help";
      help.textContent =
        "ll-auto also applies your project's confidence threshold; add --force-implement here to skip it.";
      skillRow.appendChild(help);
    }
    const sel = document.createElement("select");
    sel.setAttribute("aria-label", `${oc.name} skill`);
    if (oc.name === "implement") {
      const blank = document.createElement("option");
      blank.value = "";
      blank.textContent = "— use shell default —";
      if (oc.actionType === "shell") blank.selected = true;
      sel.appendChild(blank);
    }
    CATALOG.forEach((s) => {
      const o = document.createElement("option");
      o.value = "/ll:" + s.name;
      o.textContent = "/ll:" + s.name;
      if (oc.actionType === "slash_command" && o.value === oc.body) o.selected = true;
      sel.appendChild(o);
    });
    sel.onchange = () => {
      if (sel.value) {
        oc.actionType = "slash_command";
        oc.body = sel.value;
      } else if (oc.name === "implement") {
        oc.actionType = "shell";
        oc.body = "ll-auto --only";
      }
      renderAll();
    };
    skillRow.appendChild(sel);
    grp.appendChild(skillRow);

    const argsRow = document.createElement("div");
    argsRow.innerHTML = `<label>Args:</label>`;
    const argsInput = document.createElement("input");
    argsInput.type = "text";
    argsInput.value = oc.args || "";
    argsInput.placeholder = "--auto";
    argsInput.setAttribute("aria-label", `${oc.name} args`);
    argsInput.oninput = () => { oc.args = argsInput.value; updatePreview(); };
    argsRow.appendChild(argsInput);
    grp.appendChild(argsRow);

    const transRow = document.createElement("div");
    transRow.innerHTML = `<label>And then:</label>`;
    const bSel = document.createElement("select");
    bSel.setAttribute("aria-label", `${oc.name} follow-up`);
    [["rescore", "Score again"], ["goto", "Go to…"], ["finish", "Stop here"]].forEach(([v, t]) => {
      const o = document.createElement("option"); o.value = v; o.textContent = t;
      if (v === (oc.transition && oc.transition.kind)) o.selected = true;
      bSel.appendChild(o);
    });
    const gotoSel = document.createElement("select");
    gotoSel.setAttribute("aria-label", `${oc.name} go-to target`);
    function renderGoto() {
      gotoSel.innerHTML = "";
      state.outcomes.forEach((o2) => {
        const o = document.createElement("option"); o.value = o2.name; o.textContent = o2.name;
        if (oc.transition && oc.transition.target === o2.name) o.selected = true;
        gotoSel.appendChild(o);
      });
      gotoSel.style.display = (oc.transition && oc.transition.kind === "goto") ? "" : "none";
    }
    bSel.onchange = () => {
      oc.transition = { kind: bSel.value, target: gotoSel.value || (state.outcomes[0] && state.outcomes[0].name) };
      renderGoto(); updatePreview();
    };
    gotoSel.onchange = () => { oc.transition.target = gotoSel.value; updatePreview(); };
    renderGoto();
    transRow.appendChild(bSel);
    transRow.appendChild(gotoSel);
    grp.appendChild(transRow);

    host.appendChild(grp);
  });
}

// The ordered, numbered rule list — the primary surface (UX model §1). Each
// row reads "N. When <conditions> → <outcome>" with ↑/↓ precedence controls.
// On-screen order IS precedence order (first match wins), so reordering
// mutates state.rules via the pure moveRule() and re-renders everything,
// including the shadow-detection messages and the "Try it" winner.
function renderRules() {
  const host = $("rule-list");
  host.innerHTML = "";
  state.rules.forEach((r, i) => {
    const card = document.createElement("div");
    card.className = "rule-card";
    card.dataset.ruleIndex = String(i);

    const ord = document.createElement("span");
    ord.className = "rule-ord";
    ord.textContent = `${i + 1}.`;
    card.appendChild(ord);

    const whenLabel = document.createElement("span");
    whenLabel.textContent = "When";
    card.appendChild(whenLabel);

    r.predicates.forEach((p, pi) => {
      if (pi > 0) {
        const and = document.createElement("span");
        and.textContent = "and";
        card.appendChild(and);
      }
      const dimSel = document.createElement("select");
      dimSel.setAttribute("aria-label", "Signal");
      state.dimensions.forEach((d) => {
        const o = document.createElement("option");
        o.value = normalizeDimName(d.name);
        o.textContent = normalizeDimName(d.name);
        if (o.value === p.dim) o.selected = true;
        dimSel.appendChild(o);
      });
      const opSel = document.createElement("select");
      opSel.setAttribute("aria-label", "Comparison");
      const dimType = (state.dimensions.find((d) => normalizeDimName(d.name) === p.dim) || {}).type || "numeric";
      opsForType(dimType).forEach((op) => {
        const o = document.createElement("option");
        o.value = op; o.textContent = op;
        if (op === p.op) o.selected = true;
        opSel.appendChild(o);
      });
      const valInput = document.createElement("input");
      valInput.type = "text";
      // BUG-3486 defect d: a rejected edit stays visible via p.draft.text
      // instead of the DOM and model silently disagreeing.
      valInput.value = p.draft ? p.draft.text : p.value;
      valInput.placeholder = "value";
      valInput.setAttribute("aria-label", "Value");
      if (p.op === "==true" || p.op === "==false") valInput.disabled = true;
      if (p.draft) valInput.title = p.draft.error || "";
      dimSel.onchange = () => {
        const newType = (state.dimensions.find((d) => normalizeDimName(d.name) === dimSel.value) || {}).type || "numeric";
        Object.assign(p, reconcilePredicateForDim({ ...p, dim: dimSel.value }, newType));
        renderAll();
      };
      opSel.onchange = () => { p.op = opSel.value; renderAll(); };
      // A "string"-typed dim's rule-value input rejects empty values and
      // values containing "&" or "->" (they break the LHS-split / arrow-split
      // parse_rules() grammar). Invalid input is kept visible as a draft
      // (BUG-3486) rather than silently discarded — validateBuilderModel
      // blocks export while any predicate carries a non-null draft.
      valInput.oninput = () => {
        const curType = (state.dimensions.find((d) => normalizeDimName(d.name) === p.dim) || {}).type;
        const v = valInput.value;
        if (curType === "string" && (v.trim() === "" || v.includes("&") || v.includes("->"))) {
          const error = 'A condition value must be non-empty and cannot contain "&" or "->".';
          p.draft = { text: v, error };
          valInput.title = error;
          updatePreview();
          return;
        }
        p.draft = null;
        valInput.title = "";
        p.value = v;
        updatePreview();
      };
      card.append(dimSel, opSel, valInput);
      if (r.predicates.length > 1) {
        const delPred = document.createElement("button");
        delPred.className = "secondary del"; delPred.textContent = "✕";
        delPred.title = "Remove this condition";
        delPred.onclick = () => { r.predicates.splice(pi, 1); renderAll(); commit(); };
        card.appendChild(delPred);
      }
    });

    const addPred = document.createElement("button");
    addPred.className = "secondary"; addPred.textContent = "+ and";
    addPred.title = "Add another condition to this rule";
    addPred.onclick = () => {
      const firstDim = state.dimensions[0];
      const dim = firstDim ? normalizeDimName(firstDim.name) : "";
      const op = firstDim && firstDim.type === "boolean" ? "==true" : (GRAMMAR.all_ops[0] || "==");
      r.predicates.push({ dim, op, value: "" });
      renderAll();
      commit();
    };
    card.appendChild(addPred);

    const arrow = document.createElement("span");
    arrow.textContent = "→";
    card.appendChild(arrow);

    const targetSel = document.createElement("select");
    targetSel.setAttribute("aria-label", "Outcome");
    state.outcomes.forEach((oc) => {
      const o = document.createElement("option"); o.value = oc.name; o.textContent = oc.name;
      if (oc.name === r.target) o.selected = true;
      targetSel.appendChild(o);
    });
    targetSel.onchange = () => { r.target = targetSel.value; updatePreview(); };
    card.appendChild(targetSel);

    const upBtn = document.createElement("button");
    upBtn.className = "secondary rule-move"; upBtn.textContent = "↑";
    upBtn.title = "Move rule up (higher precedence)";
    upBtn.disabled = i === 0;
    upBtn.onclick = () => { state.rules = moveRule({ rules: state.rules }, i, "up").rules; renderAll(); commit(); };
    const downBtn = document.createElement("button");
    downBtn.className = "secondary rule-move"; downBtn.textContent = "↓";
    downBtn.title = "Move rule down (lower precedence)";
    downBtn.disabled = i === state.rules.length - 1;
    downBtn.onclick = () => { state.rules = moveRule({ rules: state.rules }, i, "down").rules; renderAll(); commit(); };
    card.append(upBtn, downBtn);

    const del = document.createElement("button");
    del.className = "secondary del"; del.textContent = "✕"; del.title = "Delete this rule";
    del.onclick = () => { state.rules.splice(i, 1); renderAll(); commit(); };
    card.appendChild(del);

    host.appendChild(card);
  });
}

// "Try it" (UX model §8): one input per dimension for Decision Table mode,
// highlighting the first-matching rule row live via evaluateModel().
// Highlight-the-winner only — no state execution.
// issue_lifecycle mode has its own frontmatter-paste Try-it panel instead
// (renderFrontmatterTryIt/updateFrontmatterTryIt, below); rubric mode has none.
function renderTryIt() {
  const host = $("tryit-inputs");
  host.innerHTML = "";
  if (state.mode === "issue_lifecycle") {
    renderFrontmatterTryIt();
    return;
  }
  if (state.mode !== "decision_table") return;
  state.dimensions.forEach((d) => {
    const dimKey = normalizeDimName(d.name);
    const row = document.createElement("div");
    row.className = "row";
    const label = document.createElement("label");
    label.textContent = dimKey;
    label.style.margin = "0";
    row.appendChild(label);
    let input;
    if (d.type === "boolean") {
      input = document.createElement("select");
      [["", "—"], ["true", "true"], ["false", "false"]].forEach(([v, t]) => {
        const o = document.createElement("option"); o.value = v; o.textContent = t; input.appendChild(o);
      });
    } else {
      input = document.createElement("input");
      input.type = "number";
    }
    input.setAttribute("aria-label", `${dimKey} sample value`);
    input.dataset.dim = dimKey;
    input.oninput = updateTryIt;
    input.onchange = updateTryIt;
    row.appendChild(input);
    host.appendChild(row);
  });
  updateTryIt();
}

// Highlight the row identified by an evaluateModel() MatchResult: the
// authored rule card when ruleIndex points at one, otherwise the pinned
// fallback footer when the derived catch-all fallback matched (BUG-3486
// defect b: winner identity, not a target-name lookup that can pick the
// wrong row for a repeated target or silently no-op on a fallback match).
function _highlightWinner(result) {
  document.querySelectorAll(".rule-card").forEach((el) => el.classList.remove("rule-winner"));
  $("fallback-row").classList.remove("rule-winner");
  if (result.target == null) return;
  if (result.ruleIndex >= 0) {
    const row = document.querySelector(`.rule-card[data-rule-index="${result.ruleIndex}"]`);
    if (row) row.classList.add("rule-winner");
  } else if (result.isFallback) {
    $("fallback-row").classList.add("rule-winner");
  }
}

function updateTryIt() {
  if (state.mode === "issue_lifecycle") {
    updateFrontmatterTryIt();
    return;
  }
  if (state.mode !== "decision_table") {
    _highlightWinner({ ruleIndex: -1, target: null, isFallback: false });
    return;
  }
  const scores = {};
  document.querySelectorAll("#tryit-inputs [data-dim]").forEach((el) => {
    if (el.value === "") return;
    scores[el.dataset.dim] = el.tagName === "SELECT" ? (el.value === "true" ? 100 : 0) : Number(el.value);
  });
  const model = buildModel();
  _highlightWinner(evaluateModel(model, scores));
}

// FEAT-3474: the issue_lifecycle Try-it panel. Parses the pasted frontmatter
// with the pure mini-parser, encodes it with the same rules the
// frontmatter_scores fragment uses, and evaluates via evaluateModel (which
// compiles through _serializeRulesText/parseRuleTable internally) — never
// buildModel().rules directly (see Encoding Rules § Try-it evaluates
// compiled rules: the decision-table Try-it's raw-rules pattern was a
// pre-existing bug for ==false predicates and must not be copied here).
function renderFrontmatterTryIt() {
  const input = $("fm-tryit-input");
  if (input && !input.dataset.wired) {
    input.oninput = updateFrontmatterTryIt;
    input.dataset.wired = "1";
  }
  updateFrontmatterTryIt();
}

function updateFrontmatterTryIt() {
  const input = $("fm-tryit-input");
  const hint = $("fm-tryit-hint");
  if (!input || !hint) return;
  const text = input.value;
  if (!text.trim()) {
    hint.textContent = "";
    _highlightWinner({ ruleIndex: -1, target: null, isFallback: false });
    return;
  }
  let fm;
  try {
    fm = parseFrontmatterBlock(text);
  } catch (err) {
    hint.textContent = err.message;
    _highlightWinner({ ruleIndex: -1, target: null, isFallback: false });
    return;
  }
  const model = buildModel();
  const scores = encodeFrontmatterScores(fm, model.dimensions);
  const pairs = Object.keys(scores).map((k) => `${k}=${scores[k]}`).join(", ");
  hint.textContent = pairs || "(no scored dimensions)";
  _highlightWinner(evaluateModel(model, scores));
}

// BUG-3486: `diagnostics` is validateBuilderModel(model)'s output, computed
// once by updatePreview() and passed in — renderMessages() no longer runs
// its own detectShadows() pass (validateBuilderModel absorbs it). The two
// checks left inline here (unreachable outcomes, unknown skill actions)
// depend on data validateBuilderModel doesn't have access to (respectively
// `state.mode`'s suppression rule and the project's skill CATALOG), so they
// stay template-side.
function renderMessages(model, diagnostics) {
  const host = $("messages");
  host.innerHTML = "";
  const add = (cls, text) => {
    const li = document.createElement("li"); li.className = cls; li.textContent = text; host.appendChild(li);
  };
  diagnostics.forEach((d) => add(d.severity === "error" ? "msg-error" : "msg-warn", d.message));
  if (state.mode === "decision_table") {
    // Outcomes unreachable by any rule and not the fallback. Suppressed in
    // issue_lifecycle mode: unused verbs are expected (left out of the
    // saved loop), not a mistake.
    state.outcomes.forEach((oc) => {
      const reached = model.rules.some((r) => r.target === oc.name) || model.fallback === oc.name;
      if (!reached) add("msg-warn", `Outcome "${oc.name}" has no rule and isn't the fallback — it can only be reached via "Go to".`);
    });
  }
  // Unknown skill actions. Skips "shell" outcomes (issue_lifecycle's
  // implement default) — those are never checked against the skill catalog.
  const known = new Set(CATALOG.map((s) => "/ll:" + s.name));
  state.outcomes.forEach((oc) => {
    if (oc.actionType === "slash_command" && oc.body && !known.has(oc.body)) {
      add("msg-error", `Outcome "${oc.name}" references an unknown skill: ${oc.body}`);
    }
  });
  if (!host.children.length) add("msg-ok", "No issues detected.");
}

// Export guidance (ENH-3487): a concrete destination path, the validate
// command, and a runnable `ll-loop run` invocation. issue_lifecycle declares
// a required `parameters.issue_id` bound by a JSON-object positional input
// (ll-loop run.py's context-key matching); rubric declares `input_key:
// subject` / `required_inputs: ["subject"]` bound by a bare positional
// string. decision_table takes no positional input (subject is a fixed
// context default), so it needs neither.
function _runCommandFor(model, destPath) {
  if (model.mode === "issue_lifecycle") return `ll-loop run ${destPath} '{"issue_id": "BUG-123"}'`;
  if (model.mode === "rubric") return `ll-loop run ${destPath} "Subject to evaluate"`;
  return `ll-loop run ${destPath}`;
}
function _exportGuidance(model) {
  const destPath = `loops/${model.name || "my-policy-loop"}.yaml`;
  return [
    `Save to: ${destPath}`,
    `Validate: ll-loop validate ${destPath}`,
    `Run: ${_runCommandFor(model, destPath)}`,
  ].join("\n");
}

function updatePreview() {
  const model = buildModel();
  // BUG-3489: serializeLoopYaml throws when the model uses a reserved
  // outcome/rule-target/fallback token. A guard error must not stop the
  // rest of the panel from updating on the very keystroke that introduced
  // the bad token — catch it, show the diagnostic in the preview pane, and
  // keep rendering summary/messages/try-it so the page stays responsive.
  try {
    $("yaml-preview").textContent = serializeLoopYaml(model);
    $("validate-hint").textContent = _exportGuidance(model);
  } catch (err) {
    $("yaml-preview").textContent = `# Cannot generate YAML:\n# ${err.message}`;
    $("validate-hint").textContent = "";
  }
  // BUG-3486: export is blocked on error-severity diagnostics, but the
  // preview above still rendered (or showed its own throw) regardless —
  // the user can always see what would be emitted.
  const diagnostics = validateBuilderModel(model);
  const hasError = diagnostics.some((d) => d.severity === "error");
  $("copy-btn").disabled = hasError;
  $("download-btn").disabled = hasError;
  $("yaml-summary").textContent = computeSummary(model);
  renderMessages(model, diagnostics);
  updateTryIt();
}

function renderAll() {
  renderDimensions();
  renderFallback();
  if (state.mode === "decision_table") {
    renderOutcomes();
    renderRules();
  } else if (state.mode === "issue_lifecycle") {
    renderLifecycleOutcomes();
    renderRules();
  } else {
    // Rubric mode hides these fieldsets entirely (Mode asymmetry); clear
    // stale DOM so a mode switch never leaves orphaned rows behind.
    $("outcome-list").innerHTML = "";
    $("rule-list").innerHTML = "";
  }
  renderTryIt();
  updatePreview();
}

function applyModeVisibility() {
  const isLifecycle = state.mode === "issue_lifecycle";
  $("threshold-fieldset").hidden = state.mode !== "rubric";
  $("outcomes-fieldset").hidden = state.mode === "rubric";
  $("rules-fieldset").hidden = state.mode === "rubric";
  $("tryit-fieldset").hidden = state.mode !== "decision_table";
  $("frontmatter-tryit-fieldset").hidden = !isLifecycle;
  // #add-outcome is hidden in issue_lifecycle mode — the verb set is fixed;
  // no outcome can be added or removed.
  $("outcome-add-row").hidden = isLifecycle;
  $("dim-help").textContent = isLifecycle
    ? "Built-in fields come from the issue's frontmatter and can't be removed. Add your own fields below."
    : "Boolean dimensions are scored 100/0 and compiled to numeric conditions.";
  $("outcome-help").textContent = isLifecycle
    ? "Every verb is available as a rule target; verbs no rule routes to are left out of the saved loop."
    : "Name each destination once; rules below route to these outcomes by name.";
}

// Push the current `state`'s identity fields onto the form controls — shared
// by the mode switch and "Start blank" handlers, both of which fully
// replace `state`.
function applyStateToForm() {
  $("f-name").value = state.name;
  $("f-subject").value = state.subject;
  $("f-maxsteps").value = state.maxSteps;
  $("f-desc").value = state.description;
  $("mode-switch").value = state.mode;
}

// ---- event wiring --------------------------------------------------------
$("mode-switch").value = state.mode;
// FEAT-3474 mode-switch semantics: every mode change fully reseeds `state`
// via seedExample(<new mode>) — the same data-loss contract as "Start
// blank" — so issue_lifecycle's built-in dimensions/verbs are always
// present when switching in, and switching to any other mode never leaves
// stale lifecycle-only fields (args, frontmatter dims) behind.
// ENH-3487: mode switch no longer discards in-progress edits — it saves the
// outgoing mode's draft and restores the incoming mode's saved draft (or
// seeds it, the first time a mode is visited). "Start blank" is still the
// only way to discard a mode's work, and it now pushes a history entry
// first so that reseed is itself undoable.
$("mode-switch").onchange = (e) => {
  const newMode = e.target.value;
  drafts = { ...drafts, [state.mode]: { model: state } };
  const existing = drafts[newMode];
  state = existing ? existing.model : seedExample(newMode);
  drafts = { ...drafts, [newMode]: { model: state } };
  applyStateToForm();
  applyModeVisibility();
  renderAll();
  commit();
};
$("f-name").oninput = (e) => { state.name = e.target.value; updatePreview(); };
$("f-subject").oninput = (e) => { state.subject = e.target.value; updatePreview(); };
$("f-maxsteps").oninput = (e) => { state.maxSteps = Number(e.target.value) || 1; updatePreview(); };
$("f-desc").oninput = (e) => { state.description = e.target.value; updatePreview(); };
$("f-thigh").oninput = (e) => { state.thresholdHigh = Number(e.target.value); $("thigh-val").textContent = e.target.value; updatePreview(); };
$("f-tmed").oninput = (e) => { state.thresholdMedium = Number(e.target.value); $("tmed-val").textContent = e.target.value; updatePreview(); };

// ENH-3487 history granularity: one entry per *committed* field change, not
// per keystroke. A native "change" event (fires on blur for text/textarea/
// number, on release for range, and on selection for select) bubbles here
// from every authoring control above and from the dynamically-rendered
// dimension/outcome/rule editors — so this single delegated listener covers
// all of them without threading commit() through every renderer. #tryit-
// fieldset / #frontmatter-tryit-fieldset hold ephemeral sample values (not
// part of the authored model) and are excluded.
$("form-panel").addEventListener("change", (e) => {
  if (e.target.closest("#tryit-fieldset, #frontmatter-tryit-fieldset")) return;
  commit();
});

$("add-dim").onclick = () => {
  const name = $("dim-name").value.trim();
  if (!name) return;
  // Custom frontmatter key names can't contain ":" or "|" (they break the
  // name:type|name:type encoding of context.frontmatter_dimensions) and
  // can't normalize to an existing dimension's name (including the derived
  // "priority_rank").
  if (name.includes(":") || name.includes("|")) {
    alert('A field name cannot contain ":" or "|".');
    return;
  }
  const norm = normalizeDimName(name);
  if (state.dimensions.some((d) => normalizeDimName(d.name) === norm)) {
    alert(`A field named "${norm}" already exists.`);
    return;
  }
  state.dimensions.push({ name, type: $("dim-type").value });
  $("dim-name").value = "";
  renderAll();
  commit();
};
$("add-outcome").onclick = () => {
  if (state.mode === "issue_lifecycle") return; // fixed verb set; #add-outcome is hidden too.
  const name = normalizeDimName($("outcome-name").value);
  if (!name) return;
  // BUG-3486: mirrors #add-dim's existing reserved/duplicate guard — catch
  // it here too, not just via validateBuilderModel after the fact.
  if (isReservedOutcomeToken(state.mode, name)) {
    alert(`"${name}" is reserved for the generated loop's own states.`);
    return;
  }
  if (state.outcomes.some((oc) => oc.name === name)) {
    alert(`An outcome named "${name}" already exists.`);
    return;
  }
  state.outcomes.push({ name, actionType: "prompt", body: "", transition: { kind: "rescore" } });
  $("outcome-name").value = "";
  renderAll();
  commit();
};
$("add-rule").onclick = () => {
  if (!state.outcomes.length) return;
  const firstDim = state.dimensions[0];
  const dim = firstDim ? normalizeDimName(firstDim.name) : "";
  const op = firstDim && firstDim.type === "boolean" ? "==true" : (GRAMMAR.all_ops[0] || "==");
  state.rules.push({ predicates: [{ dim, op, value: "" }], target: state.outcomes[0].name });
  renderAll();
  commit();
};

$("copy-btn").onclick = () => {
  const text = $("yaml-preview").textContent;
  if (!navigator.clipboard) {
    showLiveStatus("Clipboard is unavailable in this browser.");
    return;
  }
  navigator.clipboard.writeText(text).then(
    () => showLiveStatus("Copied to clipboard."),
    (err) => showLiveStatus(`Copy failed: ${err && err.message ? err.message : err}`)
  );
};
$("download-btn").onclick = () => {
  const text = $("yaml-preview").textContent;
  const blob = new Blob([text], { type: "text/yaml" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = (state.name || "policy-loop") + ".yaml";
  a.click();
  URL.revokeObjectURL(a.href);
};
$("save-project-btn").onclick = () => {
  const text = serializeBuilderProject(currentProject());
  const blob = new Blob([text], { type: "application/json" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = (state.name || "policy-builder-project") + ".project.json";
  a.click();
  URL.revokeObjectURL(a.href);
  showLiveStatus("Project saved.");
};
$("open-project-btn").onclick = () => { $("open-project-input").click(); };
$("open-project-input").onchange = (e) => {
  const file = e.target.files && e.target.files[0];
  e.target.value = ""; // allow re-selecting the same file next time
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    let project;
    try {
      project = parseBuilderProject(String(reader.result));
    } catch (err) {
      // A failed import preserves the current project untouched.
      showLiveStatus(`Could not open project: ${err.message}`);
      return;
    }
    projectId = project.projectId;
    drafts = project.drafts;
    state = drafts[project.activeMode].model;
    applyStateToForm();
    applyModeVisibility();
    renderAll();
    history = { past: [], present: { activeMode: project.activeMode, drafts }, future: [] };
    _persistAllDrafts(drafts);
    _persistMeta();
    updateUndoRedoButtons();
    showLiveStatus("Project opened.");
  };
  reader.onerror = () => showLiveStatus("Could not read the selected file.");
  reader.readAsText(file);
};

$("undo-btn").onclick = () => {
  if (!history || !history.past.length) return;
  history = applyDraftEdit(history, { type: "undo" });
  restoreFromSnapshot(history.present);
};
$("redo-btn").onclick = () => {
  if (!history || !history.future.length) return;
  history = applyDraftEdit(history, { type: "redo" });
  restoreFromSnapshot(history.present);
};
// Document-level Ctrl/Cmd+Z / Ctrl/Cmd+Shift+Z. Ignored whenever focus is in
// an input/textarea/select/contenteditable so native per-keystroke undo
// inside a field is untouched — the Undo/Redo buttons (and this shortcut
// everywhere else) always act on the project history instead.
document.addEventListener("keydown", (e) => {
  const tag = (e.target && e.target.tagName || "").toLowerCase();
  const isEditable = tag === "input" || tag === "textarea" || tag === "select" || (e.target && e.target.isContentEditable);
  if (isEditable) return;
  const mod = e.ctrlKey || e.metaKey;
  if (!mod || e.key.toLowerCase() !== "z") return;
  e.preventDefault();
  if (e.shiftKey) { $("redo-btn").click(); } else { $("undo-btn").click(); }
});

// "Never a blank form" (UX model §6): the page seeds with seedExample();
// this clears it to blankModel(state.mode) on demand — issue_lifecycle's
// blank model still carries the locked built-in dimensions and five verbs
// (they are structural to the mode, not authored content). ENH-3487: this
// reseed now pushes a history entry, so it is itself undoable.
$("start-blank-btn").onclick = () => {
  state = blankModel(state.mode);
  drafts = { ...drafts, [state.mode]: { model: state } };
  applyStateToForm();
  applyModeVisibility();
  renderAll();
  commit();
};

// ---- theme resolution: stored toggle -> stamped active_theme -> OS preference -> light
function initTheme() {
  const stored = (() => { try { return localStorage.getItem("ll-policy-builder-theme"); } catch (e) { return null; } })();
  let theme;
  if (stored) {
    theme = stored;
  } else if (window.__ACTIVE_THEME__) {
    theme = window.__ACTIVE_THEME__;
  } else if (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) {
    theme = "dark";
  } else if (window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches) {
    theme = "light";
  } else {
    theme = "light";
  }
  document.documentElement.setAttribute("data-theme", theme);
  $("theme-toggle").textContent = theme === "dark" ? "☀️" : "🌙";
}
$("theme-toggle").onclick = () => {
  const cur = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
  const next = cur === "dark" ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", next);
  $("theme-toggle").textContent = next === "dark" ? "☀️" : "🌙";
  try { localStorage.setItem("ll-policy-builder-theme", next); } catch (e) { /* ignore */ }
};

// ---- bootstrap -----------------------------------------------------------
initTheme();
hydrateFromStorage();
applyModeVisibility();
renderAll();
  </script>
</body>
</html>
