<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Policy Router Builder</title>
  <style>
/* Template-local defaults (ENH-3506): stamped blocks above/below override these at
   equal specificity, so old mirrors, partial DESIGN.md and disabled tokens stay readable. */
:root {
  color-scheme: light;
  --color-surface-primary: #ffffff;
  --color-surface-secondary: #f8f9fa;
  --color-surface-raised: #f1f3f5;
  --color-text-primary: #212529;
  --color-text-secondary: #495057;
  --color-border-subtle: #dee2e6;
  --color-border-strong: #868e96;
  --color-action-primary: #1d4ed8;
  --color-action-primary-text: #ffffff;
  --color-status-success-bg: #d4edda;
  --color-status-success-text: #155724;
  --color-status-warning-bg: #fff3cd;
  --color-status-warning-text: #664d03;
  --color-status-error-bg: #f8d7da;
  --color-status-error-text: #721c24;
  --color-status-info-bg: #d1ecf1;
  --color-status-info-text: #0c5460;
  --font-family-body: system-ui, sans-serif;
  --font-family-mono: ui-monospace, monospace;
}
[data-theme=dark] {
  color-scheme: dark;
  --color-surface-primary: #101214;
  --color-surface-secondary: #212529;
  --color-surface-raised: #343a40;
  --color-text-primary: #ffffff;
  --color-text-secondary: #dee2e6;
  --color-border-subtle: #343a40;
  --color-border-strong: #868e96;
  --color-action-primary: #3b82f6;
  --color-action-primary-text: #0b0d0f;
  --color-status-success-bg: #14532d;
  --color-status-success-text: #bbf7d0;
  --color-status-warning-bg: #713f12;
  --color-status-warning-text: #fef08a;
  --color-status-error-bg: #7f1d1d;
  --color-status-error-text: #fecaca;
  --color-status-info-bg: #164e63;
  --color-status-info-text: #a5f3fc;
}
/* Stamped design-token CSS custom properties (light :root + [data-theme=dark]). */
/*__THEMED_CSS_VARS__*/

* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: var(--font-family-body, system-ui, sans-serif);
  background: var(--color-surface-primary, #ffffff);
  color: var(--color-text-primary, #212529);
  line-height: 1.5;
}
header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.5rem;
  border-bottom: 1px solid var(--color-border-subtle, #dee2e6);
}
h1 { font-size: 1.25rem; margin: 0; }
main {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  padding: 1.5rem;
}
@media (max-width: 600px) {
  main { grid-template-columns: 1fr; }
}
.panel {
  border: 1px solid var(--color-border-subtle, #dee2e6);
  border-radius: 8px;
  padding: 1rem;
  background: var(--color-surface-raised, #f1f3f5);
}
fieldset {
  border: 1px solid var(--color-border-subtle, #dee2e6);
  border-radius: 6px;
  margin: 0 0 1rem;
  padding: 0.75rem;
}
legend { font-weight: 600; padding: 0 0.4rem; }
label { display: block; font-size: 0.85rem; margin: 0.4rem 0 0.15rem; }
input, select, textarea, button {
  font: inherit;
  color: inherit;
  background: var(--color-surface-primary, #ffffff);
  border: 1px solid var(--color-border-strong, #868e96);
  border-radius: 4px;
  padding: 0.35rem 0.5rem;
}
input[type="text"], input[type="number"], textarea, select { width: 100%; }
textarea { min-height: 4rem; resize: vertical; }
button {
  cursor: pointer;
  background: var(--color-action-primary, #1d4ed8);
  color: var(--color-action-primary-text, #ffffff);
  border: none;
}
button.secondary {
  background: transparent;
  color: var(--color-text-primary, #212529);
  border: 1px solid var(--color-border-strong, #868e96);
}
.row { display: flex; gap: 0.5rem; align-items: flex-end; flex-wrap: wrap; }
.row > * { flex: 1; }
.row > button { flex: 0 0 auto; }
.outcome-group { border: 1px dashed var(--color-border-subtle, #dee2e6); border-radius: 6px; padding: 0.6rem; margin-bottom: 0.75rem; }
.rule-row { display: flex; gap: 0.4rem; align-items: center; margin-bottom: 0.35rem; flex-wrap: wrap; }
.rule-card {
  display: flex;
  gap: 0.4rem;
  align-items: center;
  flex-wrap: wrap;
  border: 1px solid var(--color-border-subtle, #dee2e6);
  border-radius: 6px;
  padding: 0.5rem;
  margin-bottom: 0.4rem;
  background: var(--color-surface-primary, #ffffff);
}
.rule-winner {
  outline: 2px solid var(--color-action-primary, #1d4ed8);
  background: var(--color-status-success-bg, #d4edda);
}
.rule-ord { font-weight: 700; min-width: 1.5rem; }
.rule-move { flex: 0 0 auto; padding: 0.2rem 0.5rem; }
.scenario-card {
  border: 1px solid var(--color-border-subtle, #dee2e6);
  border-radius: 6px;
  padding: 0.5rem;
  margin-bottom: 0.5rem;
  background: var(--color-surface-primary, #ffffff);
}
.scenario-card .row { margin-bottom: 0.35rem; }
.scenario-verdict { margin: 0.25rem 0 0; padding: 0.2rem 0.4rem; border-radius: 4px; }
.fallback-row { font-style: italic; opacity: 0.85; }
.fallback-row select { max-width: 16rem; }
pre {
  background: var(--color-surface-secondary, #f8f9fa);
  color: var(--color-text-secondary, #495057);
  padding: 1rem;
  border-radius: 6px;
  overflow: auto;
  max-height: 60vh;
  white-space: pre;
  font-family: var(--font-family-mono, ui-monospace, monospace);
  font-size: 0.8rem;
}
.messages { margin: 0.5rem 0; padding: 0; list-style: none; }
.messages li { padding: 0.3rem 0.5rem; border-radius: 4px; margin-bottom: 0.25rem; font-size: 0.85rem; }
.msg-warn { background: var(--color-status-warning-bg, #fff3cd); color: var(--color-status-warning-text, #664d03); }
.msg-error { background: var(--color-status-error-bg, #f8d7da); color: var(--color-status-error-text, #721c24); }
.msg-ok { background: var(--color-status-success-bg, #d4edda); color: var(--color-status-success-text, #155724); }
.msg-info { background: var(--color-status-info-bg, #d1ecf1); color: var(--color-status-info-text, #0c5460); }
.hint { font-family: var(--font-family-mono, monospace); font-size: 0.8rem; opacity: 0.8; white-space: pre-line; }
.theme-toggle { font-size: 1.1rem; padding: 0.3rem 0.6rem; }
.del { flex: 0 0 auto; padding: 0.2rem 0.5rem; }
small.help { display: block; opacity: 0.7; font-size: 0.75rem; }
  </style>
</head>
<body>
  <header>
    <h1>Policy Router Builder</h1>
    <div>
      <select id="mode-switch" aria-label="Builder mode">
        <option value="decision_table">Decision Table</option>
        <option value="rubric">Rubric</option>
        <option value="issue_lifecycle">Issue Lifecycle</option>
      </select>
      <button class="secondary" id="undo-btn" type="button" title="Undo (Ctrl/Cmd+Z)">↶ Undo</button>
      <button class="secondary" id="redo-btn" type="button" title="Redo (Ctrl/Cmd+Shift+Z)">↷ Redo</button>
      <button class="secondary theme-toggle" id="theme-toggle" title="Toggle theme">🌙</button>
    </div>
  </header>

  <!-- Stamped project-derived JSON globals (plain script, before the module). -->
  <script>
    window.__GRAMMAR_SPEC__ = /*__GRAMMAR_SPEC_JSON__*/;
    window.__SKILL_CATALOG__ = /*__SKILL_CATALOG_JSON__*/;
    window.__GENERATOR_VERSION__ = /*__GENERATOR_VERSION_JSON__*/;
    window.__CONFIDENCE_GATE__ = /*__CONFIDENCE_GATE_JSON__*/;
    const CONNECTED_CONTEXT = /*__CONNECTED_CONTEXT_JSON__*/;
    window.__ACTIVE_THEME__ = document.documentElement.getAttribute("data-theme") || "light";
  </script>

  <main>
    <section class="panel" id="form-panel">
      <div class="row" id="preset-row" style="margin-bottom:0.75rem;">
        <span>Start from:</span>
        <button id="start-blank-btn" type="button" class="secondary">Start blank</button>
      </div>

      <fieldset>
        <legend>Identity</legend>
        <label for="f-name">Loop name</label>
        <input type="text" id="f-name" value="my-policy-loop" />
        <div id="subject-row">
          <label for="f-subject">What are you grading?</label>
          <input type="text" id="f-subject" value="artifact.md" placeholder="e.g. artifact.md" />
        </div>
        <label for="f-desc">Description (optional)</label>
        <textarea id="f-desc"></textarea>
      </fieldset>

      <fieldset id="threshold-fieldset" hidden>
        <legend>Thresholds (Rubric)</legend>
        <label for="f-thigh">High threshold: <span id="thigh-val">85</span></label>
        <input type="range" id="f-thigh" min="0" max="100" value="85" />
        <label for="f-tmed">Medium threshold: <span id="tmed-val">65</span></label>
        <input type="range" id="f-tmed" min="0" max="100" value="65" />
      </fieldset>

      <fieldset>
        <legend>Dimensions</legend>
        <div id="dim-list"></div>
        <div class="row">
          <input type="text" id="dim-name" placeholder="dimension name" />
          <select id="dim-type">
            <option value="numeric">numeric</option>
            <option value="boolean">boolean</option>
            <option value="string">string</option>
            <option value="list">list</option>
          </select>
          <button id="add-dim" type="button">Add</button>
        </div>
        <small class="help" id="dim-help">Boolean dimensions are scored 100/0 and compiled to numeric conditions.</small>
      </fieldset>

      <fieldset id="rules-fieldset">
        <legend>Rules (Decision Table)</legend>
        <div id="rule-list"></div>
        <div class="row">
          <button id="add-rule" type="button">+ Rule</button>
        </div>
        <div class="row fallback-row" id="fallback-row">
          <span>Otherwise →</span>
          <select id="f-fallback" aria-label="Fallback outcome" title="Fallback outcome"></select>
        </div>
      </fieldset>

      <fieldset id="tryit-fieldset">
        <legend>Try it</legend>
        <div id="tryit-inputs"></div>
        <small class="help">Enter sample values to see which rule wins — reordering rules above changes the winner live.</small>
      </fieldset>

      <fieldset id="frontmatter-tryit-fieldset" hidden>
        <legend>Try it</legend>
        <textarea id="fm-tryit-input" rows="8" aria-label="Paste issue frontmatter" placeholder="status: open
priority: P2
confidence_score: 40"></textarea>
        <p class="hint" id="fm-tryit-hint"></p>
      </fieldset>

      <fieldset id="scenarios-fieldset">
        <legend>Scenarios</legend>
        <div id="scenario-list"></div>
        <div class="row">
          <button id="add-scenario-btn" type="button" class="secondary">+ Scenario</button>
          <button id="run-all-btn" type="button">Run all</button>
          <button id="suggest-scenarios-btn" type="button" class="secondary">Suggest cases</button>
          <span id="import-controls">
            <button id="import-issue-btn" type="button" class="secondary">Import issue file</button>
            <input type="file" id="import-issue-input" accept=".md,text/markdown,text/plain" hidden />
          </span>
        </div>
        <p class="hint" id="import-diagnostics" role="status" aria-live="polite"></p>
        <p class="hint" id="scenario-summary">No scenarios yet.</p>
        <p class="hint" id="scenario-coverage"></p>
        <small class="help">Named cases you save and re-run offline — no skill, shell, or action ever executes.</small>
      </fieldset>

      <details id="advanced-details">
        <summary>Advanced: action bindings and budget</summary>
        <fieldset>
          <legend>Budget</legend>
          <label for="f-maxsteps">Max steps</label>
          <input type="number" id="f-maxsteps" value="20" min="1" />
          <p class="hint" id="confidence-gate-info"></p>
        </fieldset>

        <fieldset id="outcomes-fieldset">
          <legend>Outcomes</legend>
          <div id="outcome-list"></div>
          <div class="row" id="outcome-add-row">
            <input type="text" id="outcome-name" placeholder="new outcome name" />
            <button id="add-outcome" type="button">Add outcome</button>
          </div>
          <small class="help" id="outcome-help">Name each destination once; rules below route to these outcomes by name.</small>
        </fieldset>
      </details>
    </section>

    <section class="panel">
      <h2 style="margin-top:0;font-size:1rem;">Result</h2>
      <p id="yaml-summary"></p>
      <p class="hint" id="transition-summary" hidden></p>
      <ul class="messages" id="transition-graph" hidden></ul>
      <ul class="messages" id="messages"></ul>
      <div class="row" style="margin-bottom:0.5rem;">
        <button id="copy-btn" type="button">Copy</button>
        <button id="download-btn" type="button">Download &lt;name&gt;.yaml</button>
        <button id="save-project-btn" type="button" class="secondary">Save project</button>
        <button id="open-project-btn" type="button" class="secondary">Open project</button>
        <input type="file" id="open-project-input" accept="application/json" hidden />
      </div>
      <p class="hint" id="live-status" role="status" aria-live="polite"></p>
      <p class="hint" id="validate-hint"></p>
      <details id="yaml-details">
        <summary>View generated file</summary>
        <pre id="yaml-preview"></pre>
      </details>
    </section>
  </main>

  <script type="module">
/*__BUILDER_CORE_JS__*/

// ===========================================================================
// UI glue — reads window.__GRAMMAR_SPEC__ / window.__SKILL_CATALOG__ and wires
// a working (visually basic) form to the inlined core. State is a single model
// object matching serializeLoopYaml's contract.
// ===========================================================================
const GRAMMAR = window.__GRAMMAR_SPEC__ || { all_ops: ["==", "!=", ">=", "<=", "<", ">"], ordered_ops: [">=", "<=", "<", ">"] };
const CATALOG = window.__SKILL_CATALOG__ || [];
// ENH-3492: the project's confidence-gate config, stamped at generation time.
// Display-only — never used to rewrite an authored rule threshold.
const CONFIDENCE_GATE = window.__CONFIDENCE_GATE__ || { enabled: false, readiness_threshold: 85, outcome_threshold: 65 };

// `state` is the template's own authoring model — same flat shape as the
// serializer's model contract (see policy_builder_core.mjs header), so
// buildModel() is close to identity and `seedExample()`/`blankModel()` can be
// assigned to it directly (FEAT-2301). Rules are a single ordered array (not
// nested per-outcome) so on-screen order *is* precedence order and moveRule()
// can reorder it directly.
let state = seedExample();

// ===========================================================================
// Draft / project persistence and undo/redo (ENH-3487)
// ===========================================================================
// `drafts` mirrors BuilderProject.drafts: {[mode]: {model}} for every mode
// visited this session. `history` is a whole-project DraftHistory (see
// applyDraftEdit's doc comment in policy_builder_core.mjs) — null until
// hydrateFromStorage() seeds it, so calls to commit() before bootstrap
// finishes (there are none) are a safe no-op.
let drafts = {};
let projectId = _newProjectId();
let history = null;

// FEAT-3503: monotonic session revision — incremented by commit(), snapshot
// restoration, Open, and the start of every import/Open read. An asynchronous
// FileReader completion is bound to the revision captured when it began and
// is discarded if the revision has moved. `_latestReadToken` marks the most
// recently started read so a superseded one is dropped silently (last
// selection wins) while a read invalidated by an edit reports a diagnostic.
let sessionRevision = 0;
let _latestReadToken = 0;
function _beginRead() {
  sessionRevision += 1;
  _latestReadToken = sessionRevision;
  return sessionRevision;
}
// "current" | "superseded" | "stale"
function _readStatus(token) {
  if (token < _latestReadToken) return "superseded";
  return token === sessionRevision ? "current" : "stale";
}

// FEAT-3488: `drafts[mode]` is the sole owner of `scenarios` — `state` stays
// model-only. `scenarios` mirrors the *active* mode's saved suite; every
// place that rebuilds `drafts[mode] = {model: state}` must also carry it.
let scenarios = [];
// Last runScenarioSuite() result, or null when stale (any committed edit
// invalidates it — see commit()). Never persisted: derived data, not an
// authored assertion.
let lastSuiteRun = null;

const ALL_MODES = ["decision_table", "rubric", "issue_lifecycle"];

function _newProjectId() {
  if (window.crypto && typeof window.crypto.randomUUID === "function") return window.crypto.randomUUID();
  return "proj-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 10);
}

function _newScenarioId() {
  if (window.crypto && typeof window.crypto.randomUUID === "function") return window.crypto.randomUUID();
  return "scn-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 10);
}

function showLiveStatus(text) {
  const el = document.getElementById("live-status");
  if (el) el.textContent = text;
}

// ENH-3507: all draft/meta/issue-selection storage goes through the core's
// injected-storage helper (workspace-namespaced when served connected). The
// once-per-session warning latch lives inside the helper; authoring and
// explicit Save-project stay fully functional either way. localStorage is
// acquired guarded — a bare reference throws SecurityError when blocked.
let _ls = null;
try { _ls = window.localStorage; } catch (e) { /* blocked */ }
const builderStorage = createBuilderStorage({
  storage: _ls,
  connectedContext: CONNECTED_CONTEXT,
  warn: () =>
    showLiveStatus("Browser storage is unavailable — drafts won't survive reload this session; use Save project instead."),
});
function _persistMeta() {
  builderStorage.persistMeta({
    projectId,
    activeMode: state.mode,
    schemaVersion: BUILDER_PROJECT_SCHEMA_VERSION,
    generatorVersion: window.__GENERATOR_VERSION__ || "",
  });
}

function currentProject() {
  return {
    schemaVersion: BUILDER_PROJECT_SCHEMA_VERSION,
    generatorVersion: window.__GENERATOR_VERSION__ || "",
    projectId,
    activeMode: state.mode,
    // Merge into the existing wrapper (never rebuild {model, scenarios} from
    // scratch) so unknown JSON-compatible sibling metadata on this mode's
    // draft — e.g. from an opened forward-compatible project — round-trips.
    drafts: { ...drafts, [state.mode]: { ...drafts[state.mode], model: state, scenarios } },
  };
}

// Push one committed edit onto the undo/redo stack and persist it. Called
// after every structural button-driven mutation (add/delete/move a
// dimension/outcome/rule/scenario, mode switch, Start blank, preset) and,
// via the delegated `change` listener below, after every settled
// (non-keystroke) field edit — including scenario editors, since
// #scenarios-fieldset is inside #form-panel and not excluded there.
function commit() {
  sessionRevision += 1;
  if (!history) return;
  drafts = { ...drafts, [state.mode]: { ...drafts[state.mode], model: state, scenarios } };
  history = applyDraftEdit(history, { type: "commit", activeMode: state.mode, drafts });
  builderStorage.persistDraft(state.mode, state, scenarios);
  _persistMeta();
  updateUndoRedoButtons();
  // FEAT-3488: results are derived data, never authoritative — any
  // committed edit (policy or scenario) invalidates the last Run all.
  lastSuiteRun = null;
  _renderSuiteRunResults();
}

function updateUndoRedoButtons() {
  $("undo-btn").disabled = !history || !history.past.length;
  $("redo-btn").disabled = !history || !history.future.length;
}

function restoreFromSnapshot(snapshot) {
  sessionRevision += 1;
  drafts = _deepClone(snapshot.drafts);
  const mode = snapshot.activeMode;
  const entry = drafts[mode];
  state = (entry && entry.model) || seedExample(mode);
  scenarios = (entry && entry.scenarios) || [];
  applyStateToForm();
  applyModeVisibility();
  renderAll();
  builderStorage.persistAllDrafts(drafts);
  _persistMeta();
  updateUndoRedoButtons();
}

// Restore every saved mode's draft from localStorage (not just the active
// one — a mode switch after reload must see a previously saved suite, not
// silently reseed), validating structure only (never export-readiness — an
// unfinished predicate, empty action body, missing reference, or invalid
// budget is editable work, not corruption, and must still restore). A
// structurally invalid stored draft is skipped with a live-region
// diagnostic when it's the active mode; the rejected payload is left in
// storage untouched until the next explicit commit() overwrites it, so it
// stays available for manual recovery.
function hydrateFromStorage() {
  const meta = builderStorage.readMeta();
  const activeMode = (meta && meta.activeMode) || state.mode;
  const loaded = {};
  let activeModeCorrupted = false;
  for (const mode of ALL_MODES) {
    const draft = builderStorage.readDraft(mode);
    if (!draft) continue;
    const candidate = {
      schemaVersion: BUILDER_PROJECT_SCHEMA_VERSION,
      generatorVersion: (meta && meta.generatorVersion) || "",
      projectId: (meta && meta.projectId) || projectId,
      activeMode: mode,
      drafts: { [mode]: draft },
    };
    const errors = validateProjectStructure(candidate);
    if (!errors.length) {
      loaded[mode] = draft.scenarios === undefined ? { ...draft, scenarios: [] } : draft;
    } else if (mode === activeMode) {
      activeModeCorrupted = true;
    }
  }
  if (Object.keys(loaded).length) {
    projectId = (meta && meta.projectId) || projectId;
    drafts = loaded;
  }
  if (drafts[activeMode]) {
    state = drafts[activeMode].model;
    scenarios = drafts[activeMode].scenarios || [];
    applyStateToForm();
  } else if (activeModeCorrupted) {
    showLiveStatus("Saved draft could not be restored (corrupted); starting from the example instead.");
  }
  history = {
    past: [],
    present: _deepClone({
      activeMode: state.mode,
      drafts: { ...drafts, [state.mode]: { model: state, scenarios } },
    }),
    future: [],
  };
  updateUndoRedoButtons();
}

function buildModel() {
  return {
    mode: state.mode,
    name: state.name,
    description: state.description,
    subject: state.subject,
    maxSteps: state.maxSteps,
    thresholdHigh: state.thresholdHigh,
    thresholdMedium: state.thresholdMedium,
    dimensions: state.dimensions,
    rules: state.rules.map((r) => ({ predicates: r.predicates, target: r.target, isCatchall: false })),
    fallback: state.fallback,
    outcomes: state.outcomes.map((o) => {
      const projected = { name: o.name, actionType: o.actionType, body: o.body, args: o.args, transition: o.transition };
      if (o.verificationContract) projected.verificationContract = o.verificationContract;
      return projected;
    }),
  };
}

// One-line plain-language stand-in for the raw YAML (UX model §5 — the YAML
// itself is demoted behind a collapsed <details>; this summary is the
// default view).
function computeSummary(model) {
  const dims = (model.dimensions || []).length;
  const subject = model.subject || "the artifact";
  const steps = model.maxSteps != null ? model.maxSteps : 20;
  if (model.mode === "issue_lifecycle") {
    // ENH-3492: "reaches:" includes author-selected destinations (rule
    // target/fallback/verb transition.kind), not just verbs — otherwise a
    // rule routing straight to e.g. "skipped" would render "reaches: nothing yet".
    const verbs = _emittedVerbs(model);
    const destinations = _dispatchedDestinations(model);
    const routed = [...verbs, ...destinations];
    const routedText = routed.length ? routed.join(" → ") : "nothing yet";
    return `Routes an issue through its frontmatter on ${dims} field${dims === 1 ? "" : "s"}, runs ≤${steps}×, reaches: ${routedText}.`;
  }
  if (model.mode === "rubric") {
    return `Scores ${subject} on ${dims} signal${dims === 1 ? "" : "s"}, runs ≤${steps}×, routes to high/medium/low tiers.`;
  }
  const finishOutcome = (model.outcomes || []).find((o) => o.transition && o.transition.kind === "finish");
  const firstOutcome = model.outcomes && model.outcomes[0];
  const stopsAt = finishOutcome ? finishOutcome.name : model.fallback || (firstOutcome && firstOutcome.name) || "done";
  return `Scores ${subject} on ${dims} signal${dims === 1 ? "" : "s"}, runs ≤${steps}×, stops at ${stopsAt}.`;
}

// opsForType(type) now lives in policy_builder_core.mjs (BUG-3486) — shared
// by the rule editor here and reconcilePredicateForDim.

// ---- renderers -----------------------------------------------------------
const $ = (id) => document.getElementById(id);

// ENH-3491: plain-language description + argument hint for a `/ll:<name>`
// skill body, shown next to the skill <select> in both outcome editors.
function _skillHintFor(body) {
  const name = String(body || "").replace(/^\/ll:/, "");
  const entry = CATALOG.find((s) => s.name === name);
  if (!entry) return "";
  return entry.args_hint ? `${entry.description || ""} — ${entry.args_hint}` : entry.description || "";
}

// FEAT-3474: built-in issue_lifecycle dimensions render locked (no ✕) in
// #dim-list, ahead of any custom rows. Computed once from the normalized
// built-in name set; state.dimensions is seeded builtins-then-custom and
// built-ins can never be deleted or reordered, so plain array order already
// satisfies "built-ins first, then custom rows in insertion order."
const BUILTIN_DIM_NAMES = new Set(BUILTIN_FRONTMATTER_DIMENSIONS.map((d) => normalizeDimName(d.name)));

// ENH-3492: serialize a dimension's anchors array to/from the compact
// "score:meaning, score:meaning" text the single-line editor below reads.
function _anchorsToText(anchors) {
  return (anchors || []).map((a) => `${a.score}:${a.meaning}`).join(", ");
}
function _anchorsFromText(text) {
  const parts = String(text)
    .split(",")
    .map((p) => p.trim())
    .filter((p) => p.length > 0);
  const anchors = [];
  for (const part of parts) {
    const idx = part.indexOf(":");
    if (idx === -1) continue;
    const score = Number(part.slice(0, idx).trim());
    const meaning = part.slice(idx + 1).trim();
    if (Number.isFinite(score)) anchors.push({ score, meaning });
  }
  return anchors;
}

function renderDimensions() {
  const host = $("dim-list");
  host.innerHTML = "";
  const isLifecycle = state.mode === "issue_lifecycle";
  state.dimensions.forEach((d, i) => {
    const row = document.createElement("div");
    row.className = "rule-row";
    const norm = normalizeDimName(d.name);
    const isBuiltin = isLifecycle && BUILTIN_DIM_NAMES.has(norm);
    let html = `<strong>${norm}</strong> <em>(${d.type})</em>`;
    if (isBuiltin) {
      html += ` <small class="help">built-in</small>`;
      if (norm === "priority_rank") {
        html += ` <small class="help">(numeric, derived from priority)</small>`;
      }
    }
    row.innerHTML = html;
    if (!isBuiltin) {
      const del = document.createElement("button");
      del.className = "secondary del";
      del.textContent = "✕";
      del.onclick = () => {
        state.dimensions.splice(i, 1);
        renderAll();
        commit();
      };
      row.appendChild(del);
    }
    host.appendChild(row);

    // ENH-3492: optional per-dimension scoring instructions/anchors — hidden
    // in issue_lifecycle mode (frontmatter dimensions are deterministic
    // extraction, never LLM-graded).
    if (!isLifecycle) {
      const metaRow = document.createElement("div");
      metaRow.className = "row";
      metaRow.style.marginBottom = "0.5rem";
      const instrInput = document.createElement("input");
      instrInput.type = "text";
      instrInput.value = d.instructions || "";
      instrInput.placeholder = `Scoring instructions for ${norm} (optional)`;
      instrInput.setAttribute("aria-label", `${norm} scoring instructions`);
      instrInput.oninput = () => { d.instructions = instrInput.value; updatePreview(); };
      const anchorsInput = document.createElement("input");
      anchorsInput.type = "text";
      anchorsInput.value = _anchorsToText(d.anchors);
      anchorsInput.placeholder = "score:meaning, score:meaning (optional)";
      anchorsInput.setAttribute("aria-label", `${norm} score anchors`);
      anchorsInput.oninput = () => {
        d.anchors = _anchorsFromText(anchorsInput.value);
        updatePreview();
      };
      metaRow.append(instrInput, anchorsInput);
      host.appendChild(metaRow);
    }
  });
}

// The pinned fallback footer: a structured, non-input picker (no free text)
// over the current outcome names. Non-deletable — it always exists and has
// no remove control.
function renderFallback() {
  const sel = $("f-fallback");
  const prev = state.fallback;
  sel.innerHTML = "";
  state.outcomes.forEach((oc) => {
    const o = document.createElement("option");
    o.value = oc.name; o.textContent = oc.name;
    if (oc.name === prev) o.selected = true;
    sel.appendChild(o);
  });
  // ENH-3492: issue_lifecycle's fallback may also target a built-in
  // terminal destination directly (not just a verb).
  const isLifecycle = state.mode === "issue_lifecycle";
  if (isLifecycle) {
    LIFECYCLE_DESTINATIONS.forEach((d) => {
      const o = document.createElement("option");
      o.value = d.name; o.textContent = d.name;
      if (d.name === prev) o.selected = true;
      sel.appendChild(o);
    });
  }
  const validNames = new Set(state.outcomes.map((oc) => oc.name));
  if (isLifecycle) LIFECYCLE_DESTINATIONS.forEach((d) => validNames.add(d.name));
  if (!validNames.has(prev)) {
    state.fallback = state.outcomes.length ? state.outcomes[0].name : "";
  }
  sel.value = state.fallback;
  sel.onchange = () => { state.fallback = sel.value; updatePreview(); };
}

// Per-outcome action authoring only ("Do:" / "And then:"), named once. Rule
// editing (predicates + precedence) lives in renderRules(); outcomes here
// are just the destinations rules point at.
function renderOutcomes() {
  const host = $("outcome-list");
  host.innerHTML = "";
  state.outcomes.forEach((oc, oi) => {
    const grp = document.createElement("div");
    grp.className = "outcome-group";
    const title = document.createElement("div");
    title.className = "row";
    title.innerHTML = `<strong>${oc.name}</strong>`;
    const delOc = document.createElement("button");
    delOc.className = "secondary del";
    delOc.textContent = "✕ outcome";
    const inUse = state.fallback === oc.name || state.rules.some((r) => r.target === oc.name);
    delOc.disabled = inUse;
    delOc.title = inUse
      ? "Can't remove: still used by a rule or the fallback"
      : "Remove this outcome";
    delOc.onclick = () => { state.outcomes.splice(oi, 1); renderAll(); commit(); };
    title.appendChild(delOc);
    grp.appendChild(title);

    // "Do:" / "And then:" authoring — plain language, no internal axis names.
    const author = document.createElement("div");
    author.innerHTML = `<label>Do:</label>`;
    const aSel = document.createElement("select");
    aSel.setAttribute("aria-label", "Action");
    [["prompt", "Prompt"], ["slash_command", "Run a skill"], ["none", "Nothing"]].forEach(([v, t]) => {
      const o = document.createElement("option"); o.value = v; o.textContent = t;
      if (v === oc.actionType) o.selected = true; aSel.appendChild(o);
    });
    const bodyHost = document.createElement("div");
    function renderBody() {
      bodyHost.innerHTML = "";
      if (oc.actionType === "prompt") {
        const ta = document.createElement("textarea");
        ta.value = oc.body || "";
        ta.setAttribute("aria-label", "Prompt text");
        ta.oninput = () => { oc.body = ta.value; updatePreview(); };
        bodyHost.appendChild(ta);
      } else if (oc.actionType === "slash_command") {
        const sel = document.createElement("select");
        sel.setAttribute("aria-label", "Skill");
        const blank = document.createElement("option"); blank.value = ""; blank.textContent = "— choose skill —"; sel.appendChild(blank);
        const hint = document.createElement("small");
        hint.className = "help";
        CATALOG.forEach((s) => {
          const o = document.createElement("option");
          o.value = "/ll:" + s.name; o.textContent = "/ll:" + s.name;
          o.title = s.args_hint ? `${s.description || ""} ${s.args_hint}` : (s.description || "");
          if (o.value === oc.body) o.selected = true; sel.appendChild(o);
        });
        sel.onchange = () => { oc.body = sel.value; hint.textContent = _skillHintFor(oc.body); updatePreview(); };
        hint.textContent = _skillHintFor(oc.body);
        bodyHost.appendChild(sel);
        bodyHost.appendChild(hint);
      }
    }
    aSel.onchange = () => { oc.actionType = aSel.value; renderBody(); updatePreview(); };
    author.appendChild(aSel);
    author.appendChild(bodyHost);

    author.insertAdjacentHTML("beforeend", `<label>And then:</label>`);
    const bSel = document.createElement("select");
    bSel.setAttribute("aria-label", "Follow-up");
    [["rescore", "Score again"], ["goto", "Go to…"], ["finish", "Stop here"]].forEach(([v, t]) => {
      const o = document.createElement("option"); o.value = v; o.textContent = t;
      if (v === (oc.transition && oc.transition.kind)) o.selected = true; bSel.appendChild(o);
    });
    const gotoSel = document.createElement("select");
    gotoSel.setAttribute("aria-label", "Go to outcome");
    function renderGoto() {
      gotoSel.innerHTML = "";
      state.outcomes.forEach((o2) => {
        const o = document.createElement("option"); o.value = o2.name; o.textContent = o2.name;
        if (oc.transition && oc.transition.target === o2.name) o.selected = true; gotoSel.appendChild(o);
      });
      gotoSel.style.display = (oc.transition && oc.transition.kind === "goto") ? "" : "none";
    }
    bSel.onchange = () => {
      oc.transition = { kind: bSel.value, target: gotoSel.value || (state.outcomes[0] && state.outcomes[0].name) };
      renderGoto(); updatePreview();
    };
    gotoSel.onchange = () => { oc.transition.target = gotoSel.value; updatePreview(); };
    author.appendChild(bSel);
    author.appendChild(gotoSel);
    renderBody(); renderGoto();
    grp.appendChild(author);

    host.appendChild(grp);
  });
}

// FEAT-3474: issue_lifecycle's outcome fieldset — five fixed verb rows (no
// add/delete; "verbs cannot be deleted and no new outcomes can be added in
// this mode"). Each row is: verb name, the existing skill-catalog <select>
// (bare `/ll:<name>` values, matching the unknown-skill check), a free-text
// args input, and the existing transition <select>. `implement`'s row shows
// its shell default as read-only <code> until a catalog skill is picked,
// which flips it to a slash_command outcome — matching Verb Table § "Why
// implement is a shell action, not /ll:manage-issue".
function renderLifecycleOutcomes() {
  const host = $("outcome-list");
  host.innerHTML = "";
  state.outcomes.forEach((oc, oi) => {
    const grp = document.createElement("div");
    grp.className = "outcome-group";

    const title = document.createElement("div");
    title.className = "row";
    title.innerHTML = `<strong>${oc.name}</strong>`;
    grp.appendChild(title);

    const skillRow = document.createElement("div");
    skillRow.innerHTML = `<label>Skill:</label>`;
    if (oc.name === "implement" && oc.actionType === "shell") {
      const code = document.createElement("code");
      code.textContent = "ll-auto --only $ISSUE";
      skillRow.appendChild(code);
      const help = document.createElement("small");
      help.className = "help";
      help.textContent =
        "ll-auto also applies your project's confidence threshold; add --force-implement here to skip it.";
      skillRow.appendChild(help);
    } else if (oc.actionType === "shell") {
      const cmdInput = document.createElement("input");
      cmdInput.type = "text";
      cmdInput.value = oc.body || "";
      cmdInput.placeholder = "path/to/acceptance-check.sh";
      cmdInput.setAttribute("aria-label", `${oc.name} command`);
      cmdInput.oninput = () => { oc.body = cmdInput.value; updatePreview(); };
      skillRow.appendChild(cmdInput);
      const help = document.createElement("small");
      help.className = "help";
      help.textContent =
        "Receives the issue ID as its first argument, then any Args below. Exit 0 means the check passed.";
      skillRow.appendChild(help);
    }
    const sel = document.createElement("select");
    sel.setAttribute("aria-label", `${oc.name} skill`);
    if (oc.name === "implement") {
      const blank = document.createElement("option");
      blank.value = "";
      blank.textContent = "— use shell default —";
      if (oc.actionType === "shell") blank.selected = true;
      sel.appendChild(blank);
    }
    const skillHint = document.createElement("small");
    skillHint.className = "help";
    CATALOG.forEach((s) => {
      const o = document.createElement("option");
      o.value = "/ll:" + s.name;
      o.textContent = "/ll:" + s.name;
      o.title = s.args_hint ? `${s.description || ""} ${s.args_hint}` : (s.description || "");
      if (oc.actionType === "slash_command" && o.value === oc.body) o.selected = true;
      sel.appendChild(o);
    });
    skillHint.textContent = _skillHintFor(oc.body);
    sel.onchange = () => {
      if (sel.value) {
        oc.actionType = "slash_command";
        oc.body = sel.value;
        delete oc.verificationContract;
      } else if (oc.name === "implement") {
        oc.actionType = "shell";
        oc.body = "ll-auto --only";
      }
      renderAll();
    };
    skillRow.appendChild(sel);
    skillRow.appendChild(skillHint);
    grp.appendChild(skillRow);

    if (oc.actionType === "shell") {
      const contractRow = document.createElement("div");
      const cb = document.createElement("input");
      cb.type = "checkbox";
      cb.id = `oc-contract-${oi}`;
      cb.checked = oc.verificationContract === "acceptance_exit_code";
      cb.onchange = () => {
        if (cb.checked) oc.verificationContract = "acceptance_exit_code";
        else delete oc.verificationContract;
        updatePreview();
      };
      const lbl = document.createElement("label");
      lbl.setAttribute("for", `oc-contract-${oi}`);
      lbl.style.display = "inline";
      lbl.style.margin = "0 0 0 0.35rem";
      lbl.textContent = "Exit code 0 means acceptance checks passed";
      contractRow.append(cb, lbl);
      grp.appendChild(contractRow);
    }

    const argsRow = document.createElement("div");
    argsRow.innerHTML = `<label>Args:</label>`;
    const argsInput = document.createElement("input");
    argsInput.type = "text";
    argsInput.value = oc.args || "";
    argsInput.placeholder = "--auto";
    argsInput.setAttribute("aria-label", `${oc.name} args`);
    argsInput.oninput = () => { oc.args = argsInput.value; updatePreview(); };
    argsRow.appendChild(argsInput);
    grp.appendChild(argsRow);

    const transRow = document.createElement("div");
    transRow.innerHTML = `<label>And then:</label>`;
    const bSel = document.createElement("select");
    bSel.setAttribute("aria-label", `${oc.name} follow-up`);
    // ENH-3492: stop/skip/attention are issue_lifecycle-only terminal
    // destinations, offered here alongside the shared rescore/goto/finish
    // kinds (renderOutcomes()'s decision_table/rubric follow-up select does
    // not offer them).
    [
      ["rescore", "Score again"],
      ["goto", "Go to…"],
      ["finish", "Stop here (done)"],
      ["stop", "Stop here (success)"],
      ["skip", "Skip (success)"],
      ["attention", "Flag for attention (failure)"],
    ].forEach(([v, t]) => {
      const o = document.createElement("option"); o.value = v; o.textContent = t;
      if (v === (oc.transition && oc.transition.kind)) o.selected = true;
      bSel.appendChild(o);
    });
    const gotoSel = document.createElement("select");
    gotoSel.setAttribute("aria-label", `${oc.name} go-to target`);
    function renderGoto() {
      gotoSel.innerHTML = "";
      state.outcomes.forEach((o2) => {
        const o = document.createElement("option"); o.value = o2.name; o.textContent = o2.name;
        if (oc.transition && oc.transition.target === o2.name) o.selected = true;
        gotoSel.appendChild(o);
      });
      gotoSel.style.display = (oc.transition && oc.transition.kind === "goto") ? "" : "none";
    }
    bSel.onchange = () => {
      oc.transition = { kind: bSel.value, target: gotoSel.value || (state.outcomes[0] && state.outcomes[0].name) };
      renderGoto(); updatePreview();
    };
    gotoSel.onchange = () => { oc.transition.target = gotoSel.value; updatePreview(); };
    renderGoto();
    transRow.appendChild(bSel);
    transRow.appendChild(gotoSel);
    grp.appendChild(transRow);

    host.appendChild(grp);
  });
}

// The ordered, numbered rule list — the primary surface (UX model §1). Each
// row reads "N. When <conditions> → <outcome>" with ↑/↓ precedence controls.
// On-screen order IS precedence order (first match wins), so reordering
// mutates state.rules via the pure moveRule() and re-renders everything,
// including the shadow-detection messages and the "Try it" winner.
function renderRules() {
  const host = $("rule-list");
  host.innerHTML = "";
  state.rules.forEach((r, i) => {
    const card = document.createElement("div");
    card.className = "rule-card";
    card.dataset.ruleIndex = String(i);

    const ord = document.createElement("span");
    ord.className = "rule-ord";
    ord.textContent = `${i + 1}.`;
    card.appendChild(ord);

    const whenLabel = document.createElement("span");
    whenLabel.textContent = "When";
    card.appendChild(whenLabel);

    r.predicates.forEach((p, pi) => {
      if (pi > 0) {
        const and = document.createElement("span");
        and.textContent = "and";
        card.appendChild(and);
      }
      const dimSel = document.createElement("select");
      dimSel.setAttribute("aria-label", "Signal");
      state.dimensions.forEach((d) => {
        const o = document.createElement("option");
        o.value = normalizeDimName(d.name);
        o.textContent = normalizeDimName(d.name);
        if (o.value === p.dim) o.selected = true;
        dimSel.appendChild(o);
      });
      const opSel = document.createElement("select");
      opSel.setAttribute("aria-label", "Comparison");
      const dimType = (state.dimensions.find((d) => normalizeDimName(d.name) === p.dim) || {}).type || "numeric";
      opsForType(dimType).forEach((op) => {
        const o = document.createElement("option");
        o.value = op; o.textContent = op;
        if (op === p.op) o.selected = true;
        opSel.appendChild(o);
      });
      const valInput = document.createElement("input");
      valInput.type = "text";
      // BUG-3486 defect d: a rejected edit stays visible via p.draft.text
      // instead of the DOM and model silently disagreeing.
      valInput.value = p.draft ? p.draft.text : p.value;
      valInput.placeholder = "value";
      valInput.setAttribute("aria-label", "Value");
      if (p.op === "==true" || p.op === "==false") valInput.disabled = true;
      if (p.draft) valInput.title = p.draft.error || "";
      dimSel.onchange = () => {
        const newType = (state.dimensions.find((d) => normalizeDimName(d.name) === dimSel.value) || {}).type || "numeric";
        Object.assign(p, reconcilePredicateForDim({ ...p, dim: dimSel.value }, newType));
        renderAll();
      };
      opSel.onchange = () => { p.op = opSel.value; renderAll(); };
      // A "string"-typed dim's rule-value input rejects empty values and
      // values containing "&" or "->" (they break the LHS-split / arrow-split
      // parse_rules() grammar). Invalid input is kept visible as a draft
      // (BUG-3486) rather than silently discarded — validateBuilderModel
      // blocks export while any predicate carries a non-null draft.
      valInput.oninput = () => {
        const curType = (state.dimensions.find((d) => normalizeDimName(d.name) === p.dim) || {}).type;
        const v = valInput.value;
        if (curType === "string" && (v.trim() === "" || v.includes("&") || v.includes("->"))) {
          const error = 'A condition value must be non-empty and cannot contain "&" or "->".';
          p.draft = { text: v, error };
          valInput.title = error;
          updatePreview();
          return;
        }
        p.draft = null;
        valInput.title = "";
        p.value = v;
        updatePreview();
      };
      card.append(dimSel, opSel, valInput);
      if (r.predicates.length > 1) {
        const delPred = document.createElement("button");
        delPred.className = "secondary del"; delPred.textContent = "✕";
        delPred.title = "Remove this condition";
        delPred.onclick = () => { r.predicates.splice(pi, 1); renderAll(); commit(); };
        card.appendChild(delPred);
      }
    });

    const addPred = document.createElement("button");
    addPred.className = "secondary"; addPred.textContent = "+ and";
    addPred.title = "Add another condition to this rule";
    addPred.onclick = () => {
      const firstDim = state.dimensions[0];
      const dim = firstDim ? normalizeDimName(firstDim.name) : "";
      const op = firstDim && firstDim.type === "boolean" ? "==true" : (GRAMMAR.all_ops[0] || "==");
      r.predicates.push({ dim, op, value: "" });
      renderAll();
      commit();
    };
    card.appendChild(addPred);

    const arrow = document.createElement("span");
    arrow.textContent = "→";
    card.appendChild(arrow);

    const targetSel = document.createElement("select");
    targetSel.setAttribute("aria-label", "Outcome");
    state.outcomes.forEach((oc) => {
      const o = document.createElement("option"); o.value = oc.name; o.textContent = oc.name;
      if (oc.name === r.target) o.selected = true;
      targetSel.appendChild(o);
    });
    // ENH-3492: a rule may target a built-in terminal destination directly,
    // issue_lifecycle mode only.
    if (state.mode === "issue_lifecycle") {
      LIFECYCLE_DESTINATIONS.forEach((d) => {
        const o = document.createElement("option"); o.value = d.name; o.textContent = d.name;
        if (d.name === r.target) o.selected = true;
        targetSel.appendChild(o);
      });
    }
    targetSel.onchange = () => { r.target = targetSel.value; updatePreview(); };
    card.appendChild(targetSel);

    const upBtn = document.createElement("button");
    upBtn.className = "secondary rule-move"; upBtn.textContent = "↑";
    upBtn.title = "Move rule up (higher precedence)";
    upBtn.disabled = i === 0;
    upBtn.onclick = () => { state.rules = moveRule({ rules: state.rules }, i, "up").rules; renderAll(); commit(); };
    const downBtn = document.createElement("button");
    downBtn.className = "secondary rule-move"; downBtn.textContent = "↓";
    downBtn.title = "Move rule down (lower precedence)";
    downBtn.disabled = i === state.rules.length - 1;
    downBtn.onclick = () => { state.rules = moveRule({ rules: state.rules }, i, "down").rules; renderAll(); commit(); };
    card.append(upBtn, downBtn);

    const del = document.createElement("button");
    del.className = "secondary del"; del.textContent = "✕"; del.title = "Delete this rule";
    del.onclick = () => { state.rules.splice(i, 1); renderAll(); commit(); };
    card.appendChild(del);

    host.appendChild(card);
  });
}

// "Try it" (UX model §8): one input per dimension for Decision Table mode,
// highlighting the first-matching rule row live via evaluateModel().
// Highlight-the-winner only — no state execution.
// issue_lifecycle mode has its own frontmatter-paste Try-it panel instead
// (renderFrontmatterTryIt/updateFrontmatterTryIt, below); rubric mode has none.
function renderTryIt() {
  const host = $("tryit-inputs");
  host.innerHTML = "";
  if (state.mode === "issue_lifecycle") {
    renderFrontmatterTryIt();
    return;
  }
  if (state.mode !== "decision_table") return;
  state.dimensions.forEach((d) => {
    const dimKey = normalizeDimName(d.name);
    const row = document.createElement("div");
    row.className = "row";
    const label = document.createElement("label");
    label.textContent = dimKey;
    label.style.margin = "0";
    row.appendChild(label);
    let input;
    if (d.type === "boolean") {
      input = document.createElement("select");
      [["", "—"], ["true", "true"], ["false", "false"]].forEach(([v, t]) => {
        const o = document.createElement("option"); o.value = v; o.textContent = t; input.appendChild(o);
      });
    } else {
      input = document.createElement("input");
      input.type = "number";
    }
    input.setAttribute("aria-label", `${dimKey} sample value`);
    input.dataset.dim = dimKey;
    input.oninput = updateTryIt;
    input.onchange = updateTryIt;
    row.appendChild(input);
    host.appendChild(row);
  });
  updateTryIt();
}

// Highlight the row identified by an evaluateModel() MatchResult: the
// authored rule card when ruleIndex points at one, otherwise the pinned
// fallback footer when the derived catch-all fallback matched (BUG-3486
// defect b: winner identity, not a target-name lookup that can pick the
// wrong row for a repeated target or silently no-op on a fallback match).
function _highlightWinner(result) {
  document.querySelectorAll(".rule-card").forEach((el) => el.classList.remove("rule-winner"));
  $("fallback-row").classList.remove("rule-winner");
  if (result.target == null) return;
  if (result.ruleIndex >= 0) {
    const row = document.querySelector(`.rule-card[data-rule-index="${result.ruleIndex}"]`);
    if (row) row.classList.add("rule-winner");
  } else if (result.isFallback) {
    $("fallback-row").classList.add("rule-winner");
  }
}

function updateTryIt() {
  if (state.mode === "issue_lifecycle") {
    updateFrontmatterTryIt();
    return;
  }
  if (state.mode !== "decision_table") {
    _highlightWinner({ ruleIndex: -1, target: null, isFallback: false });
    return;
  }
  const scores = {};
  document.querySelectorAll("#tryit-inputs [data-dim]").forEach((el) => {
    if (el.value === "") return;
    scores[el.dataset.dim] = el.tagName === "SELECT" ? (el.value === "true" ? 100 : 0) : Number(el.value);
  });
  const model = buildModel();
  _highlightWinner(evaluateModel(model, scores));
}

// FEAT-3474: the issue_lifecycle Try-it panel. Parses the pasted frontmatter
// with the pure mini-parser, encodes it with the same rules the
// frontmatter_scores fragment uses, and evaluates via evaluateModel (which
// compiles through _serializeRulesText/parseRuleTable internally) — never
// buildModel().rules directly (see Encoding Rules § Try-it evaluates
// compiled rules: the decision-table Try-it's raw-rules pattern was a
// pre-existing bug for ==false predicates and must not be copied here).
function renderFrontmatterTryIt() {
  const input = $("fm-tryit-input");
  if (input && !input.dataset.wired) {
    input.oninput = updateFrontmatterTryIt;
    input.dataset.wired = "1";
  }
  updateFrontmatterTryIt();
}

function updateFrontmatterTryIt() {
  const input = $("fm-tryit-input");
  const hint = $("fm-tryit-hint");
  if (!input || !hint) return;
  const text = input.value;
  if (!text.trim()) {
    hint.textContent = "";
    _highlightWinner({ ruleIndex: -1, target: null, isFallback: false });
    return;
  }
  let fm;
  try {
    fm = parseFrontmatterBlock(text);
  } catch (err) {
    hint.textContent = err.message;
    _highlightWinner({ ruleIndex: -1, target: null, isFallback: false });
    return;
  }
  const model = buildModel();
  const scores = encodeFrontmatterScores(fm, model.dimensions);
  const pairs = Object.keys(scores).map((k) => `${k}=${scores[k]}`).join(", ");
  hint.textContent = pairs || "(no scored dimensions)";
  _highlightWinner(evaluateModel(model, scores));
}

// BUG-3486: `diagnostics` is validateBuilderModel(model)'s output, computed
// once by updatePreview() and passed in — renderMessages() no longer runs
// its own detectShadows() pass (validateBuilderModel absorbs it). The two
// checks left inline here (unreachable outcomes, unknown skill actions)
// depend on data validateBuilderModel doesn't have access to (respectively
// `state.mode`'s suppression rule and the project's skill CATALOG), so they
// stay template-side.
function renderMessages(model, diagnostics) {
  const host = $("messages");
  host.innerHTML = "";
  const add = (cls, text) => {
    const li = document.createElement("li"); li.className = cls; li.textContent = text; host.appendChild(li);
  };
  diagnostics.forEach((d) => add(d.severity === "error" ? "msg-error" : "msg-warn", d.message));
  if (state.mode === "decision_table") {
    // Outcomes unreachable by any rule and not the fallback. Suppressed in
    // issue_lifecycle mode: unused verbs are expected (left out of the
    // saved loop), not a mistake.
    state.outcomes.forEach((oc) => {
      const reached = model.rules.some((r) => r.target === oc.name) || model.fallback === oc.name;
      if (!reached) add("msg-warn", `Outcome "${oc.name}" has no rule and isn't the fallback — it can only be reached via "Go to".`);
    });
  }
  // Unknown skill actions. Skips "shell" outcomes (issue_lifecycle's
  // implement default) — those are never checked against the skill catalog.
  const known = new Set(CATALOG.map((s) => "/ll:" + s.name));
  state.outcomes.forEach((oc) => {
    if (oc.actionType === "slash_command" && oc.body && !known.has(oc.body)) {
      add("msg-error", `Outcome "${oc.name}" references an unknown skill: ${oc.body}`);
    }
  });
  if (!host.children.length) add("msg-ok", "No issues detected.");
}

// FEAT-3501: text/list adjacency rendering of the shared analyzeTransitions
// structural analysis — one line per node with outgoing edges (nodes with
// none, i.e. sinks, are omitted — there is nothing to adjacency-list), then
// one line per goto cycle (warning) and rescore_feedback cycle (info), then
// one line per unreachable outcome node. A node absent from
// reachableNodeIds but also never the target of any edge is simply an
// unused verb (normal — presets intentionally leave verbs unreferenced) and
// is not warned; only a node that IS referenced (has an inbound edge, which
// given dispatch targets are always reachable can only be a `goto` edge from
// an unreachable source) yet still unreachable is flagged. Never an SVG/
// canvas diagram — hand-rolled layout is out of scope for this issue.
function renderTransitionGraph(model, analysis) {
  const host = $("transition-graph");
  host.innerHTML = "";
  if (!analysis.nodes.length) {
    host.hidden = true;
    return;
  }
  const add = (cls, text) => {
    const li = document.createElement("li");
    if (cls) li.className = cls;
    li.textContent = text;
    host.appendChild(li);
  };

  const outgoingBySource = new Map();
  for (const e of analysis.edges) {
    if (!outgoingBySource.has(e.source)) outgoingBySource.set(e.source, []);
    outgoingBySource.get(e.source).push(e);
  }
  for (const node of analysis.nodes) {
    const outgoing = outgoingBySource.get(node.id);
    if (!outgoing || !outgoing.length) continue;
    const desc = outgoing.map((e) => `${e.target} (${e.kind})`).join(", ");
    add("", `${node.id} [${node.kind}] → ${desc}`);
  }

  for (const cycle of analysis.cycles) {
    if (cycle.kind === "goto") {
      add("msg-warn", `Goto cycle: ${cycle.nodeIds.join(" → ")} → ${cycle.nodeIds[0]}`);
    } else {
      add("msg-info", `Rescore feedback: ${cycle.nodeIds.join(" → ")}`);
    }
  }

  const reachable = new Set(analysis.reachableNodeIds);
  const hasInboundEdge = new Set(analysis.edges.map((e) => e.target));
  for (const node of analysis.nodes) {
    if (node.kind !== "outcome" || reachable.has(node.id) || !hasInboundEdge.has(node.id)) continue;
    add("msg-warn", `Outcome "${node.id}" is referenced but not reachable from score.`);
  }

  host.hidden = host.children.length === 0;
}

// ===========================================================================
// Offline scenario suites (FEAT-3488)
// ===========================================================================
// Named, independently authored per-mode test cases (drafts[mode].scenarios,
// the `scenarios` live variable above). Run all evaluates every case through
// runScenarioSuite/evaluateScenario/traceModel — the same shared trace path
// evaluateModel/Try-it use — and never executes an outcome's action.

function _blankScenarioInput(mode) {
  if (mode === "issue_lifecycle") return { frontmatterText: "" };
  if (mode === "rubric") return { aggregate: 0 };
  return { values: {} };
}

// The valid assertion-target token set for the *current* policy (mirrors
// core's own _validTargetTokens so the <select> options agree with what
// evaluateScenario will accept).
function _scenarioTargetOptions() {
  if (state.mode === "rubric") return ["done", "light_repair", "deep_repair"];
  const tokens = [];
  const seen = new Set();
  const add = (t) => { if (t && !seen.has(t)) { seen.add(t); tokens.push(t); } };
  state.rules.forEach((r) => add(r.target));
  add(state.fallback);
  state.outcomes.forEach((o) => add(o.name));
  if (state.mode === "issue_lifecycle") LIFECYCLE_DESTINATIONS.forEach((d) => add(d.name));
  return tokens;
}

// One case's mode-specific input editor — decision-table gets one field per
// current dimension (mirroring Try-it), lifecycle a frontmatter textarea,
// rubric an integer aggregate. A stale key for a since-removed dimension is
// left untouched in `sc.input.values` (not surfaced here, not repaired) —
// Run reports it, per the storage-vs-execution-validity split.
function _renderScenarioInputEditor(host, mode, sc) {
  host.innerHTML = "";
  if (mode === "rubric") {
    if (!sc.input || typeof sc.input.aggregate !== "number") {
      sc.input = { aggregate: sc.input && typeof sc.input.aggregate === "number" ? sc.input.aggregate : 0 };
    }
    const inp = document.createElement("input");
    inp.type = "number";
    inp.min = "0"; inp.max = "100";
    inp.value = sc.input.aggregate;
    inp.setAttribute("aria-label", "Scenario aggregate score");
    inp.oninput = () => { sc.input.aggregate = Number(inp.value); _invalidateSuiteRun(); };
    host.appendChild(inp);
    const hint = document.createElement("small");
    hint.className = "help";
    hint.textContent = "An assumed aggregate score — this tests routing, not a predicted LLM score.";
    host.appendChild(hint);
    return;
  }
  if (mode === "issue_lifecycle") {
    if (!sc.input || typeof sc.input.frontmatterText !== "string") sc.input = { frontmatterText: "" };
    const ta = document.createElement("textarea");
    ta.rows = 4;
    ta.value = sc.input.frontmatterText;
    ta.setAttribute("aria-label", "Scenario frontmatter text");
    ta.oninput = () => { sc.input.frontmatterText = ta.value; _invalidateSuiteRun(); };
    host.appendChild(ta);
    return;
  }
  if (!sc.input || typeof sc.input.values !== "object" || Array.isArray(sc.input.values)) {
    sc.input = { values: {} };
  }
  state.dimensions.forEach((d) => {
    const key = normalizeDimName(d.name);
    const wrap = document.createElement("div");
    const label = document.createElement("label");
    label.textContent = key;
    label.style.margin = "0";
    wrap.appendChild(label);
    let input;
    if (d.type === "boolean") {
      input = document.createElement("select");
      [["", "—"], ["true", "true"], ["false", "false"]].forEach(([v, t]) => {
        const o = document.createElement("option"); o.value = v; o.textContent = t; input.appendChild(o);
      });
      const cur = sc.input.values[key];
      input.value = cur === true ? "true" : cur === false ? "false" : "";
      input.oninput = () => {
        const v = input.value;
        if (v === "") delete sc.input.values[key];
        else sc.input.values[key] = v === "true";
        _invalidateSuiteRun();
      };
    } else {
      input = document.createElement("input");
      input.type = "number";
      input.value = Object.prototype.hasOwnProperty.call(sc.input.values, key) ? sc.input.values[key] : "";
      input.oninput = () => {
        if (input.value === "") delete sc.input.values[key];
        else sc.input.values[key] = Number(input.value);
        _invalidateSuiteRun();
      };
    }
    input.setAttribute("aria-label", `${key} scenario value`);
    wrap.appendChild(input);
    host.appendChild(wrap);
  });
}

function renderScenarios() {
  lastSuiteRun = null;
  const host = $("scenario-list");
  host.innerHTML = "";
  const mode = state.mode;
  const targetOptions = _scenarioTargetOptions();
  scenarios.forEach((sc, si) => {
    const card = document.createElement("div");
    card.className = "scenario-card";
    card.dataset.scenarioIndex = String(si);

    const nameInput = document.createElement("input");
    nameInput.type = "text";
    nameInput.className = "scenario-name-input";
    nameInput.value = sc.name || "";
    nameInput.placeholder = "case name";
    nameInput.setAttribute("aria-label", "Scenario name");
    nameInput.oninput = () => { sc.name = nameInput.value; };
    card.appendChild(nameInput);

    const inputRow = document.createElement("div");
    inputRow.className = "scenario-input-row row";
    _renderScenarioInputEditor(inputRow, mode, sc);
    card.appendChild(inputRow);

    const expectRow = document.createElement("div");
    expectRow.className = "row";

    const targetSel = document.createElement("select");
    targetSel.className = "scenario-expected-target-select";
    targetSel.setAttribute("aria-label", "Expected target");
    const blankOpt = document.createElement("option");
    blankOpt.value = "";
    blankOpt.textContent = "— unasserted —";
    if (sc.expectedTarget == null) blankOpt.selected = true;
    targetSel.appendChild(blankOpt);
    targetOptions.forEach((t) => {
      const o = document.createElement("option");
      o.value = t; o.textContent = t;
      if (sc.expectedTarget === t) o.selected = true;
      targetSel.appendChild(o);
    });
    targetSel.onchange = () => {
      sc.expectedTarget = targetSel.value || null;
      if (!sc.expectedTarget) {
        sc.expectedRuleIndex = null;
        sc.expectedFallback = false;
        sc.expectedRulesFingerprint = null;
      }
      _invalidateSuiteRun();
    };
    expectRow.appendChild(targetSel);

    if (mode !== "rubric") {
      const idxInput = document.createElement("input");
      idxInput.type = "number";
      idxInput.min = "0";
      idxInput.className = "scenario-expected-index-input";
      idxInput.setAttribute("aria-label", "Expected rule index");
      idxInput.placeholder = "rule #";
      idxInput.value = sc.expectedRuleIndex != null ? sc.expectedRuleIndex : "";
      idxInput.disabled = !!sc.expectedFallback;
      idxInput.oninput = () => {
        sc.expectedRuleIndex = idxInput.value === "" ? null : Number(idxInput.value);
        _invalidateSuiteRun();
      };
      expectRow.appendChild(idxInput);

      const fbLabel = document.createElement("label");
      fbLabel.style.display = "inline-flex";
      fbLabel.style.alignItems = "center";
      fbLabel.style.gap = "0.25rem";
      fbLabel.style.margin = "0";
      const fbCb = document.createElement("input");
      fbCb.type = "checkbox";
      fbCb.className = "scenario-expected-fallback-checkbox";
      fbCb.setAttribute("aria-label", "Expect derived fallback");
      fbCb.checked = !!sc.expectedFallback;
      fbCb.onchange = () => {
        sc.expectedFallback = fbCb.checked;
        if (fbCb.checked) sc.expectedRuleIndex = null;
        renderScenarios();
        commit();
      };
      fbLabel.append(fbCb, document.createTextNode(" derived fallback"));
      expectRow.appendChild(fbLabel);
    }

    const reconfirmBtn = document.createElement("button");
    reconfirmBtn.type = "button";
    reconfirmBtn.className = "secondary scenario-reconfirm-btn";
    reconfirmBtn.textContent = "Reconfirm expectation";
    reconfirmBtn.title = "Adopt the current trace's winner as this case's expectation";
    reconfirmBtn.onclick = () => {
      const model = buildModel();
      const trace = traceModel(model, sc.input);
      if (model.mode === "rubric") {
        const b = trace.rubricBranch;
        sc.expectedTarget = b === "high" ? "done" : b === "medium" ? "light_repair" : b === "low" ? "deep_repair" : null;
        sc.expectedRuleIndex = null;
        sc.expectedFallback = false;
        sc.expectedRulesFingerprint = null;
      } else if (trace.match) {
        sc.expectedTarget = trace.match.target;
        if (trace.match.ruleIndex === -1) {
          sc.expectedFallback = true;
          sc.expectedRuleIndex = null;
        } else {
          sc.expectedFallback = false;
          sc.expectedRuleIndex = trace.match.ruleIndex;
        }
        sc.expectedRulesFingerprint = rulesFingerprint(model);
      }
      renderScenarios();
      commit();
    };
    expectRow.appendChild(reconfirmBtn);
    card.appendChild(expectRow);

    const verdictEl = document.createElement("div");
    verdictEl.className = "scenario-verdict hint";
    card.appendChild(verdictEl);

    const delBtn = document.createElement("button");
    delBtn.type = "button";
    delBtn.className = "secondary del scenario-delete-btn";
    delBtn.textContent = "✕ case";
    delBtn.onclick = () => { scenarios.splice(si, 1); renderScenarios(); commit(); };
    card.appendChild(delBtn);

    host.appendChild(card);
  });
  _renderSuiteRunResults();
}

function _invalidateSuiteRun() {
  lastSuiteRun = null;
  _renderSuiteRunResults();
}

function _renderSuiteRunResults() {
  const summaryEl = $("scenario-summary");
  const coverageEl = $("scenario-coverage");
  if (!summaryEl || !coverageEl) return;
  document.querySelectorAll(".scenario-verdict").forEach((el) => {
    el.textContent = "";
    el.className = "scenario-verdict hint";
  });
  if (!lastSuiteRun) {
    summaryEl.textContent = scenarios.length ? "Not yet run — click Run all." : "No scenarios yet.";
    coverageEl.textContent = "";
    return;
  }
  const s = lastSuiteRun.summary;
  summaryEl.textContent = `${s.passed} passed, ${s.failed} failed, ${s.unasserted} unasserted, ${s.errors} error${s.errors === 1 ? "" : "s"}.`;
  const cov = lastSuiteRun.coverage;
  if (state.mode === "rubric") {
    coverageEl.textContent =
      `Rubric branches covered: ${cov.winningRubricBranches.join(", ") || "none"}; ` +
      `uncovered: ${cov.uncoveredRubricBranches.join(", ") || "none"}.`;
  } else {
    coverageEl.textContent =
      `Winning rule indexes: ${cov.winningRuleIndexes.join(", ") || "none"}; ` +
      `evaluated: ${cov.evaluatedRuleIndexes.join(", ") || "none"}; ` +
      `uncovered: ${cov.uncoveredRuleIndexes.join(", ") || "none"}; ` +
      `fallback: ${cov.fallback.applicable ? (cov.fallback.covered ? "covered" : "uncovered") : "n/a"}.`;
  }
  lastSuiteRun.results.forEach((r) => {
    const card = document.querySelector(`.scenario-card[data-scenario-index="${r.position}"]`);
    const verdictEl = card && card.querySelector(".scenario-verdict");
    if (!verdictEl) return;
    const label = r.needsReview ? `${r.verdict} (needs review)` : r.verdict;
    const actual = r.actualTarget == null ? "(none)" : r.actualTarget;
    const diagText = r.diagnostics.length ? "; " + r.diagnostics.map((d) => d.message).join(" ") : "";
    verdictEl.textContent = `${label} — actual: ${actual}${diagText}`;
    verdictEl.classList.add(
      r.verdict === "pass" ? "msg-ok" : r.verdict === "fail" || r.verdict === "error" ? "msg-error" : "msg-warn"
    );
  });
}

$("add-scenario-btn").onclick = () => {
  scenarios.push({
    id: _newScenarioId(),
    name: "",
    input: _blankScenarioInput(state.mode),
    expectedTarget: null,
    expectedRuleIndex: null,
    expectedFallback: false,
    expectedRulesFingerprint: null,
  });
  renderScenarios();
  commit();
};

// FEAT-3503: add every deterministic boundary suggestion not already present
// (semantic-key dedup against all valid existing cases) as one committed edit.
$("suggest-scenarios-btn").onclick = () => {
  const model = buildModel();
  const existing = new Set(
    scenarios.map((sc) => scenarioSemanticKey(model, sc.input)).filter((k) => k != null)
  );
  const fresh = suggestScenarios(model).filter((sg) => !existing.has(sg.key));
  if (!fresh.length) {
    showLiveStatus("No new suggested cases to add.");
    return;
  }
  for (const sg of fresh) {
    scenarios.push({
      id: _newScenarioId(),
      name: `${sg.name} — ${sg.reason}`,
      input: sg.input,
      expectedTarget: null,
      expectedRuleIndex: null,
      expectedFallback: false,
      expectedRulesFingerprint: null,
    });
  }
  renderScenarios();
  commit();
  showLiveStatus(`Added ${fresh.length} suggested case${fresh.length === 1 ? "" : "s"}.`);
};

// FEAT-3503: import one local issue .md file as an unasserted lifecycle case.
// The read is bound to the project, mode, and session revision captured here.
$("import-issue-btn").onclick = () => { $("import-issue-input").click(); };
$("import-issue-input").onchange = (e) => {
  const file = e.target.files && e.target.files[0];
  e.target.value = "";
  if (!file || state.mode !== "issue_lifecycle") return;
  const diag = $("import-diagnostics");
  diag.textContent = "";
  const token = _beginRead();
  const boundMode = state.mode;
  const boundProject = projectId;
  const reader = new FileReader();
  reader.onload = () => {
    const status = _readStatus(token);
    if (status === "superseded") return;
    if (status === "stale" || state.mode !== boundMode || projectId !== boundProject) {
      diag.textContent = "Import discarded: the project changed while the file was being read.";
      return;
    }
    let imported;
    try {
      imported = buildImportedScenario(buildModel(), String(reader.result), file.name);
    } catch (err) {
      diag.textContent = err.message;
      return;
    }
    scenarios.push({
      id: _newScenarioId(),
      name: imported.name,
      input: imported.input,
      expectedTarget: null,
      expectedRuleIndex: null,
      expectedFallback: false,
      expectedRulesFingerprint: null,
    });
    renderScenarios();
    commit();
    diag.textContent = `Imported ${imported.name}.`;
  };
  reader.onerror = () => {
    if (_readStatus(token) === "superseded") return;
    diag.textContent = "Frontmatter: could not read the selected file.";
  };
  reader.readAsText(file);
};

$("run-all-btn").onclick = () => {
  const model = buildModel();
  lastSuiteRun = runScenarioSuite(model, scenarios);
  _renderSuiteRunResults();
};

// Export guidance (ENH-3487): a concrete destination path, the validate
// command, and a runnable `ll-loop run` invocation. issue_lifecycle declares
// a required `parameters.issue_id` bound by a JSON-object positional input
// (ll-loop run.py's context-key matching); rubric declares `input_key:
// subject` / `required_inputs: ["subject"]` bound by a bare positional
// string. decision_table takes no positional input (subject is a fixed
// context default), so it needs neither.
function _runCommandFor(model, destPath) {
  if (model.mode === "issue_lifecycle") return `ll-loop run ${destPath} '{"issue_id": "BUG-123"}'`;
  if (model.mode === "rubric") return `ll-loop run ${destPath} "Subject to evaluate"`;
  return `ll-loop run ${destPath}`;
}
function _exportGuidance(model) {
  const destPath = `loops/${model.name || "my-policy-loop"}.yaml`;
  return [
    `Save to: ${destPath}`,
    `Validate: ll-loop validate ${destPath}`,
    `Run: ${_runCommandFor(model, destPath)}`,
  ].join("\n");
}

function updatePreview() {
  const model = buildModel();
  // BUG-3489: serializeLoopYaml throws when the model uses a reserved
  // outcome/rule-target/fallback token. A guard error must not stop the
  // rest of the panel from updating on the very keystroke that introduced
  // the bad token — catch it, show the diagnostic in the preview pane, and
  // keep rendering summary/messages/try-it so the page stays responsive.
  try {
    $("yaml-preview").textContent = serializeLoopYaml(model);
    $("validate-hint").textContent = _exportGuidance(model);
  } catch (err) {
    $("yaml-preview").textContent = `# Cannot generate YAML:\n# ${err.message}`;
    $("validate-hint").textContent = "";
  }
  // BUG-3486: export is blocked on error-severity diagnostics, but the
  // preview above still rendered (or showed its own throw) regardless —
  // the user can always see what would be emitted.
  const diagnostics = validateBuilderModel(model);
  const hasError = diagnostics.some((d) => d.severity === "error");
  $("copy-btn").disabled = hasError;
  $("download-btn").disabled = hasError;
  $("yaml-summary").textContent = computeSummary(model);
  renderMessages(model, diagnostics);
  renderTransitionGraph(model, analyzeTransitions(model));
  updateTryIt();

  // ENH-3491: a collapsed advanced-details hides the field a diagnostic
  // points at — force it open whenever an outcomes/maxSteps error exists.
  // Never auto-closed (the user may be mid-edit elsewhere).
  if (diagnostics.some((d) => d.severity === "error" && (d.field === "outcomes" || d.field === "maxSteps"))) {
    $("advanced-details").open = true;
  }

  if (model.mode === "issue_lifecycle") {
    const ts = summarizeTransitions(model);
    const verificationText = {
      acceptance: "a configured acceptance check (exit code)",
      issue_validation: "issue-file validation (/ll:verify-issues), not acceptance verification",
      unconfigured: "an unconfigured acceptance check — export is blocked until it has a command",
      custom: "a custom action, not a recognized verification step",
      none: "no verification",
    }[ts.verification];
    // ENH-3492: `steps` reports verbs only; append author-selected
    // destinations (rule target/fallback/verb transition.kind) so a rule
    // routing straight to e.g. "skipped" isn't reported as reaching nothing.
    const reached = [...ts.steps, ..._dispatchedDestinations(model)];
    const stopText = ts.stopsAfterImplement
      ? ` Stops after implement at "${ts.stopDestination}"${ts.stopDestination === "needs_attention" ? " (failure)" : ""}.`
      : "";
    $("transition-summary").textContent =
      `Reaches: ${reached.length ? reached.join(" → ") : "nothing yet"}. ` +
      `Verification: ${verificationText}.${stopText} ${ts.maxStepsNote}.`;
    $("transition-summary").hidden = false;
  } else {
    $("transition-summary").hidden = true;
  }

  // FEAT-3488: a policy edit invalidates any displayed Run all results —
  // they are derived data, never an authoritative record of the last edit.
  lastSuiteRun = null;
  _renderSuiteRunResults();
}

function renderAll() {
  renderDimensions();
  renderFallback();
  if (state.mode === "decision_table") {
    renderOutcomes();
    renderRules();
  } else if (state.mode === "issue_lifecycle") {
    renderLifecycleOutcomes();
    renderRules();
  } else {
    // Rubric mode hides these fieldsets entirely (Mode asymmetry); clear
    // stale DOM so a mode switch never leaves orphaned rows behind.
    $("outcome-list").innerHTML = "";
    $("rule-list").innerHTML = "";
  }
  renderTryIt();
  renderScenarios();
  updatePreview();
}

function applyModeVisibility() {
  const isLifecycle = state.mode === "issue_lifecycle";
  $("subject-row").hidden = isLifecycle;
  $("threshold-fieldset").hidden = state.mode !== "rubric";
  $("outcomes-fieldset").hidden = state.mode === "rubric";
  $("rules-fieldset").hidden = state.mode === "rubric";
  $("tryit-fieldset").hidden = state.mode !== "decision_table";
  $("frontmatter-tryit-fieldset").hidden = !isLifecycle;
  // FEAT-3503: an issue file only means something as lifecycle input.
  $("import-controls").hidden = !isLifecycle;
  $("import-diagnostics").hidden = !isLifecycle;
  // #add-outcome is hidden in issue_lifecycle mode — the verb set is fixed;
  // no outcome can be added or removed.
  $("outcome-add-row").hidden = isLifecycle;
  $("dim-help").textContent = isLifecycle
    ? "Built-in fields come from the issue's frontmatter and can't be removed. Add your own fields below."
    : "Boolean dimensions are scored 100/0 and compiled to numeric conditions.";
  $("outcome-help").textContent = isLifecycle
    ? "Every verb is available as a rule target; verbs no rule routes to are left out of the saved loop."
    : "Name each destination once; rules below route to these outcomes by name.";
}

// Push the current `state`'s identity fields onto the form controls — shared
// by the mode switch and "Start blank" handlers, both of which fully
// replace `state`.
function applyStateToForm() {
  $("f-name").value = state.name;
  $("f-subject").value = state.subject;
  $("f-maxsteps").value = state.maxSteps;
  $("f-desc").value = state.description;
  $("mode-switch").value = state.mode;
}

// ---- event wiring --------------------------------------------------------
$("mode-switch").value = state.mode;
// FEAT-3474 mode-switch semantics: every mode change fully reseeds `state`
// via seedExample(<new mode>) — the same data-loss contract as "Start
// blank" — so issue_lifecycle's built-in dimensions/verbs are always
// present when switching in, and switching to any other mode never leaves
// stale lifecycle-only fields (args, frontmatter dims) behind.
// ENH-3487: mode switch no longer discards in-progress edits — it saves the
// outgoing mode's draft and restores the incoming mode's saved draft (or
// seeds it, the first time a mode is visited). "Start blank" is still the
// only way to discard a mode's work, and it now pushes a history entry
// first so that reseed is itself undoable.
$("mode-switch").onchange = (e) => {
  const newMode = e.target.value;
  drafts = { ...drafts, [state.mode]: { ...drafts[state.mode], model: state, scenarios } };
  const existing = drafts[newMode];
  state = existing ? existing.model : seedExample(newMode);
  scenarios = existing ? existing.scenarios || [] : [];
  drafts = { ...drafts, [newMode]: { ...existing, model: state, scenarios } };
  applyStateToForm();
  applyModeVisibility();
  renderAll();
  commit();
};
// ENH-3491: apply a task preset. Cross-mode presets (Preset ↔ mode contract)
// save the outgoing draft, switch the mode select, and replace only the
// target mode's draft wrapper — same-mode presets take the same path minus
// the select update. Exactly one commit() call, so exactly one history
// entry either way (one undo restores both activeMode and that mode's
// prior draft when the mode changed).
function applyPreset(preset) {
  drafts = { ...drafts, [state.mode]: { ...drafts[state.mode], model: state, scenarios } };
  if (preset.mode !== state.mode) {
    $("mode-switch").value = preset.mode;
  }
  const model = preset.build();
  // FEAT-3488: preset apply clears only the destination suite atomically
  // with its model swap (one commit() => one undo restores both).
  scenarios = [];
  drafts = { ...drafts, [preset.mode]: { model, scenarios } };
  state = model;
  applyStateToForm();
  applyModeVisibility();
  renderAll();
  commit();
}

function renderPresetButtons() {
  const host = $("preset-row");
  taskPresets().forEach((preset) => {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "secondary";
    btn.textContent = preset.label;
    btn.title = preset.description;
    btn.onclick = () => applyPreset(preset);
    host.appendChild(btn);
  });
}

// ENH-3492: display the project's stamped confidence-gate configuration
// alongside authored rule thresholds. Static (independent of `state`) —
// never reads from or writes to the model, so it cannot overwrite a saved
// predicate.
function renderConfidenceGateInfo() {
  const el = $("confidence-gate-info");
  if (!el) return;
  el.textContent = CONFIDENCE_GATE.enabled
    ? `Project confidence gate: enabled — readiness ≥${CONFIDENCE_GATE.readiness_threshold}, outcome ≥${CONFIDENCE_GATE.outcome_threshold}.`
    : `Project confidence gate: disabled.`;
}

$("f-name").oninput = (e) => { state.name = e.target.value; updatePreview(); };
$("f-subject").oninput = (e) => { state.subject = e.target.value; updatePreview(); };
$("f-maxsteps").oninput = (e) => { state.maxSteps = Number(e.target.value) || 1; updatePreview(); };
$("f-desc").oninput = (e) => { state.description = e.target.value; updatePreview(); };
$("f-thigh").oninput = (e) => { state.thresholdHigh = Number(e.target.value); $("thigh-val").textContent = e.target.value; updatePreview(); };
$("f-tmed").oninput = (e) => { state.thresholdMedium = Number(e.target.value); $("tmed-val").textContent = e.target.value; updatePreview(); };

// ENH-3487 history granularity: one entry per *committed* field change, not
// per keystroke. A native "change" event (fires on blur for text/textarea/
// number, on release for range, and on selection for select) bubbles here
// from every authoring control above and from the dynamically-rendered
// dimension/outcome/rule editors — so this single delegated listener covers
// all of them without threading commit() through every renderer. #tryit-
// fieldset / #frontmatter-tryit-fieldset hold ephemeral sample values (not
// part of the authored model) and are excluded.
$("form-panel").addEventListener("change", (e) => {
  // FEAT-3503: the import file input is excluded too — selecting a file must
  // push no history entry (a bubbled commit() would bump the revision and
  // discard the import as stale).
  if (e.target.closest("#tryit-fieldset, #frontmatter-tryit-fieldset, #import-issue-input")) return;
  commit();
});

$("add-dim").onclick = () => {
  const name = $("dim-name").value.trim();
  if (!name) return;
  // Custom frontmatter key names can't contain ":" or "|" (they break the
  // name:type|name:type encoding of context.frontmatter_dimensions) and
  // can't normalize to an existing dimension's name (including the derived
  // "priority_rank").
  if (name.includes(":") || name.includes("|")) {
    alert('A field name cannot contain ":" or "|".');
    return;
  }
  const norm = normalizeDimName(name);
  if (state.dimensions.some((d) => normalizeDimName(d.name) === norm)) {
    alert(`A field named "${norm}" already exists.`);
    return;
  }
  state.dimensions.push({ name, type: $("dim-type").value });
  $("dim-name").value = "";
  renderAll();
  commit();
};
$("add-outcome").onclick = () => {
  if (state.mode === "issue_lifecycle") return; // fixed verb set; #add-outcome is hidden too.
  const name = normalizeDimName($("outcome-name").value);
  if (!name) return;
  // BUG-3486: mirrors #add-dim's existing reserved/duplicate guard — catch
  // it here too, not just via validateBuilderModel after the fact.
  if (isReservedOutcomeToken(state.mode, name)) {
    alert(`"${name}" is reserved for the generated loop's own states.`);
    return;
  }
  if (state.outcomes.some((oc) => oc.name === name)) {
    alert(`An outcome named "${name}" already exists.`);
    return;
  }
  state.outcomes.push({ name, actionType: "prompt", body: "", transition: { kind: "rescore" } });
  $("outcome-name").value = "";
  renderAll();
  commit();
};
$("add-rule").onclick = () => {
  if (!state.outcomes.length) return;
  const firstDim = state.dimensions[0];
  const dim = firstDim ? normalizeDimName(firstDim.name) : "";
  const op = firstDim && firstDim.type === "boolean" ? "==true" : (GRAMMAR.all_ops[0] || "==");
  state.rules.push({ predicates: [{ dim, op, value: "" }], target: state.outcomes[0].name });
  renderAll();
  commit();
};

$("copy-btn").onclick = () => {
  const text = $("yaml-preview").textContent;
  if (!navigator.clipboard) {
    showLiveStatus("Clipboard is unavailable in this browser.");
    return;
  }
  navigator.clipboard.writeText(text).then(
    () => showLiveStatus("Copied to clipboard."),
    (err) => showLiveStatus(`Copy failed: ${err && err.message ? err.message : err}`)
  );
};
$("download-btn").onclick = () => {
  const text = $("yaml-preview").textContent;
  const blob = new Blob([text], { type: "text/yaml" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = (state.name || "policy-loop") + ".yaml";
  a.click();
  URL.revokeObjectURL(a.href);
};
$("save-project-btn").onclick = () => {
  const text = serializeBuilderProject(currentProject());
  const blob = new Blob([text], { type: "application/json" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = (state.name || "policy-builder-project") + ".project.json";
  a.click();
  URL.revokeObjectURL(a.href);
  showLiveStatus("Project saved.");
};
$("open-project-btn").onclick = () => { $("open-project-input").click(); };
$("open-project-input").onchange = (e) => {
  const file = e.target.files && e.target.files[0];
  e.target.value = ""; // allow re-selecting the same file next time
  if (!file) return;
  const token = _beginRead();
  const reader = new FileReader();
  reader.onload = () => {
    // FEAT-3503: same revision guard as issue import — an edit, undo/redo,
    // mode switch, preset, or a newer read since this one began discards it.
    const status = _readStatus(token);
    if (status === "superseded") return;
    if (status === "stale") {
      showLiveStatus("Open discarded: the project changed while the file was being read.");
      return;
    }
    let project;
    try {
      project = parseBuilderProject(String(reader.result));
    } catch (err) {
      // A failed import preserves the current project untouched.
      showLiveStatus(`Could not open project: ${err.message}`);
      return;
    }
    project = withScenariosDefaulted(project);
    sessionRevision += 1;
    projectId = project.projectId;
    drafts = project.drafts;
    state = drafts[project.activeMode].model;
    scenarios = drafts[project.activeMode].scenarios || [];
    applyStateToForm();
    applyModeVisibility();
    renderAll();
    history = { past: [], present: _deepClone({ activeMode: project.activeMode, drafts }), future: [] };
    // FEAT-3488: replace/scope the stored draft set to this project's modes
    // only — a mode absent here must never resurrect a previous project's
    // draft/suite on a later reload or mode switch.
    builderStorage.clearDraftsExcept(new Set(Object.keys(project.drafts)), ALL_MODES);
    builderStorage.persistAllDrafts(drafts);
    _persistMeta();
    updateUndoRedoButtons();
    showLiveStatus("Project opened.");
  };
  reader.onerror = () => showLiveStatus("Could not read the selected file.");
  reader.readAsText(file);
};

$("undo-btn").onclick = () => {
  if (!history || !history.past.length) return;
  history = applyDraftEdit(history, { type: "undo" });
  restoreFromSnapshot(history.present);
};
$("redo-btn").onclick = () => {
  if (!history || !history.future.length) return;
  history = applyDraftEdit(history, { type: "redo" });
  restoreFromSnapshot(history.present);
};
// Document-level Ctrl/Cmd+Z / Ctrl/Cmd+Shift+Z. Ignored whenever focus is in
// an input/textarea/select/contenteditable so native per-keystroke undo
// inside a field is untouched — the Undo/Redo buttons (and this shortcut
// everywhere else) always act on the project history instead.
document.addEventListener("keydown", (e) => {
  const tag = (e.target && e.target.tagName || "").toLowerCase();
  const isEditable = tag === "input" || tag === "textarea" || tag === "select" || (e.target && e.target.isContentEditable);
  if (isEditable) return;
  const mod = e.ctrlKey || e.metaKey;
  if (!mod || e.key.toLowerCase() !== "z") return;
  e.preventDefault();
  if (e.shiftKey) { $("redo-btn").click(); } else { $("undo-btn").click(); }
});

// "Never a blank form" (UX model §6): the page seeds with seedExample();
// this clears it to blankModel(state.mode) on demand — issue_lifecycle's
// blank model still carries the locked built-in dimensions and five verbs
// (they are structural to the mode, not authored content). ENH-3487: this
// reseed now pushes a history entry, so it is itself undoable.
$("start-blank-btn").onclick = () => {
  state = blankModel(state.mode);
  // FEAT-3488: Start blank clears this mode's suite too (same atomic-clear
  // contract as applyPreset — one commit(), one undo restores both).
  scenarios = [];
  drafts = { ...drafts, [state.mode]: { model: state, scenarios } };
  applyStateToForm();
  applyModeVisibility();
  renderAll();
  commit();
};

// ---- theme resolution: stored toggle -> stamped active_theme -> OS preference -> light
function initTheme() {
  const stored = (() => { try { return localStorage.getItem("ll-policy-builder-theme"); } catch (e) { return null; } })();
  let theme;
  if (stored) {
    theme = stored;
  } else if (window.__ACTIVE_THEME__) {
    theme = window.__ACTIVE_THEME__;
  } else if (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) {
    theme = "dark";
  } else if (window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches) {
    theme = "light";
  } else {
    theme = "light";
  }
  document.documentElement.setAttribute("data-theme", theme);
  $("theme-toggle").textContent = theme === "dark" ? "☀️" : "🌙";
}
$("theme-toggle").onclick = () => {
  const cur = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
  const next = cur === "dark" ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", next);
  $("theme-toggle").textContent = next === "dark" ? "☀️" : "🌙";
  try { localStorage.setItem("ll-policy-builder-theme", next); } catch (e) { /* ignore */ }
};

// ---- bootstrap -----------------------------------------------------------
initTheme();
renderPresetButtons();
renderConfidenceGateInfo();
hydrateFromStorage();
applyModeVisibility();
renderAll();
  </script>
</body>
</html>
