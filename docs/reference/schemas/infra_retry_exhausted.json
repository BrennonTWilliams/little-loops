{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "little-loops://event-infra_retry_exhausted.json",
  "title": "Infra Retry Exhausted",
  "description": "Emitted once the infra-retry budget is spent and the executor falls through to normal verdict routing (BUG-2731).",
  "type": "object",
  "required": [
    "event",
    "ts",
    "state",
    "retries"
  ],
  "properties": {
    "event": {
      "type": "string",
      "description": "Event type identifier"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "state": {
      "type": "string",
      "description": "State name that exhausted infra retries"
    },
    "retries": {
      "type": "integer",
      "description": "Total retries attempted before exhaustion"
    }
  },
  "additionalProperties": true
}
